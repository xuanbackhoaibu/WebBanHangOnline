@page
@model RegisterModel

@{
    ViewData["Title"] = "Đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/auth.css" asp-append-version="true" />
}

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-card-body">
            <div class="auth-head">
                <div class="auth-icon">
                    <i class="bi bi-person-plus"></i>
                </div>
                <span class="catalog-kicker">Account</span>
                <h3>Đăng ký tài khoản</h3>
                <p>Tạo tài khoản để lưu địa chỉ, theo dõi đơn và mua hàng nhanh hơn.</p>
            </div>

            <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                <div asp-validation-summary="ModelOnly" class="auth-alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email"
                           class="form-control"
                           placeholder="email@example.com"
                           autocomplete="username" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password"
                           class="form-control"
                           placeholder="Mật khẩu"
                           autocomplete="new-password" />
                    <label asp-for="Input.Password">Mật khẩu</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-floating mb-4">
                    <input asp-for="Input.ConfirmPassword"
                           class="form-control"
                           placeholder="Nhập lại mật khẩu"
                           autocomplete="new-password" />
                    <label asp-for="Input.ConfirmPassword">Xác nhận mật khẩu</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="auth-submit">
                    Đăng ký
                </button>

                <div class="text-center">
                    <span class="small">Đã có tài khoản?</span>
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">
                        Đăng nhập
                    </a>
                </div>
            </form>

            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <hr />
                <div class="text-center">
                    <p class="text-muted mb-2">Hoặc đăng ký bằng</p>

                    <form asp-page="./ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit"
                                    class="btn btn-outline-secondary me-2 mb-2"
                                    name="provider"
                                    value="@provider.Name">
                                @provider.DisplayName
                            </button>
                        }
                    </form>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
