@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Truy cập bị từ chối";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/auth.css" asp-append-version="true" />
}

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-card-body text-center">
            <div class="auth-icon">
                <i class="bi bi-shield-lock"></i>
            </div>
            <div class="auth-head">
                <h1>Truy cập bị từ chối</h1>
                <p>Bạn không có quyền mở chức năng này. Hãy đăng nhập bằng tài khoản phù hợp hoặc quay lại trang chủ.</p>
            </div>
            <div class="auth-link-row">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="auth-submit">
                    <i class="bi bi-arrow-left"></i>
                    Quay về trang chủ
                </a>
                <a asp-page="/Account/Login">Đăng nhập tài khoản khác</a>
            </div>
        </div>
    </div>
</div>
