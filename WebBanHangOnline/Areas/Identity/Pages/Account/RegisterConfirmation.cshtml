@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Xác nhận đăng ký";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/auth.css" asp-append-version="true" />
}

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-card-body text-center">
            <div class="auth-icon">
                <i class="bi bi-envelope-check"></i>
            </div>
            <div class="auth-head">
                <h1>Xác nhận đăng ký</h1>
                <p>Hoàn tất bước xác nhận để bắt đầu mua sắm và theo dõi đơn hàng của bạn.</p>
            </div>

            @if (Model.DisplayConfirmAccountLink)
            {
                <div class="auth-note text-start">
                    <strong>Chưa cấu hình gửi email</strong>
                    <span>Trong môi trường thật, link xác nhận sẽ được gửi qua email.</span>
                    <a id="confirm-link" href="@Model.EmailConfirmationUrl">Xác nhận tài khoản</a>
                </div>
            }
            else
            {
                <p class="auth-muted">Chúng tôi đã gửi email xác nhận đến địa chỉ của bạn.</p>
            }

            <a asp-page="./Login" class="auth-submit mt-3">
                Đăng nhập
            </a>
        </div>
    </div>
</div>
