@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/auth.css" asp-append-version="true" />
}

<div class="auth-shell">
    <div class="auth-card auth-card-wide">
        <div class="auth-card-body">
            <div class="auth-head">
                <div class="auth-icon">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <span class="catalog-kicker">Account</span>
                <h3>Quên mật khẩu</h3>
                <p>Nhập email đã đăng ký để nhận liên kết đặt lại mật khẩu.</p>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly"
                     class="auth-alert"
                     role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email"
                           class="form-control"
                           placeholder="name@example.com"
                           autocomplete="username" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="auth-submit">
                    Gửi liên kết đặt lại mật khẩu
                </button>
            </form>

            <div class="text-center">
                <a asp-page="./Login" class="text-decoration-none">
                    Quay lại đăng nhập
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
