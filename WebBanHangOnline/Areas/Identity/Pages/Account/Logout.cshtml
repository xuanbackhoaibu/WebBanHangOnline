@page
@model LogoutModel
@{
    ViewData["Title"] = "Đăng xuất";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/auth.css" asp-append-version="true" />
}

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-card-body text-center">
            <div class="auth-icon">
                <i class="bi bi-box-arrow-right"></i>
            </div>
            <div class="auth-head">
                <h1>Đăng xuất</h1>
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <p>Bạn có chắc chắn muốn rời khỏi tài khoản hiện tại không?</p>
                }
                else
                {
                    <p>Bạn đã đăng xuất thành công. Hẹn gặp lại trong lần mua sắm tiếp theo.</p>
                }
            </div>

            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Content("~/")"
                      method="post">
                    <button type="submit" class="auth-submit mb-2">
                        Đăng xuất
                    </button>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary w-100">
                        Quay về trang chủ
                    </a>
                </form>
            }
            else
            {
                <a asp-page="./Login" class="auth-submit">
                    Đăng nhập lại
                </a>
            }
        </div>
    </div>
</div>
