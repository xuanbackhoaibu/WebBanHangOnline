@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Gửi lại email xác nhận";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/auth.css" asp-append-version="true" />
}

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-card-body">
            <div class="auth-icon">
                <i class="bi bi-envelope-paper"></i>
            </div>
            <div class="auth-head">
                <h1>Gửi lại email xác nhận</h1>
                <p>Nhập email đã đăng ký để nhận lại liên kết kích hoạt tài khoản.</p>
            </div>

            <form method="post">
                <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email"
                           class="form-control"
                           placeholder="name@example.com" />
                    <label asp-for="Input.Email"></label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <button type="submit" class="auth-submit">
                    Gửi lại email
                </button>
            </form>

            <div class="auth-link-row">
                <a asp-page="./Login">
                    <i class="bi bi-arrow-left"></i>
                    Quay lại đăng nhập
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
