@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Kiểm tra email";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/auth.css" asp-append-version="true" />
}

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-card-body text-center">
            <div class="auth-icon">
                <i class="bi bi-envelope-check"></i>
            </div>
            <div class="auth-head">
                <h1>Kiểm tra email</h1>
                <p>Liên kết đặt lại mật khẩu đã được gửi nếu email tồn tại trong hệ thống.</p>
            </div>
            <a asp-page="./Login" class="auth-submit">
                Quay lại đăng nhập
            </a>
        </div>
    </div>
</div>
