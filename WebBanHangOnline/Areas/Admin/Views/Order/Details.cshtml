@model Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<h2><i class="bi bi-receipt"></i> Chi tiết đơn #@Model.Id</h2>

<p><strong>Khách:</strong> @Model.User?.UserName</p>
<p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
<p><strong>Phương thức thanh toán:</strong> @Model.PaymentMethod</p>
<p><strong>Trạng thái thanh toán:</strong> @Model.PaymentStatus</p>
<p><strong>Tổng tiền:</strong> <span class="text-danger fw-bold">
    @String.Format("{0:N0} VND", Model.TotalAmount)
</span></p>

<hr />

<h5><i class="bi bi-arrow-repeat"></i> Cập nhật trạng thái</h5>

<form asp-area="Admin"
      asp-controller="Order"
      asp-action="UpdateStatus"
      method="post"
      class="mb-3">
    
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id"/>

    <select name="status" class="form-select d-inline w-auto">
        <option value="Pending" selected="@(Model.Status == "Pending")">Đang chờ</option>
        <option value="Confirmed" selected="@(Model.Status == "Confirmed")">Đã xác nhận</option>
        <option value="Shipping" selected="@(Model.Status == "Shipping")">Đang vận chuyển</option>
        <option value="Completed" selected="@(Model.Status == "Completed")">Đã hoàn thành</option>
        <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Đã hủy</option>
    </select>

    <button type="submit" class="btn btn-success ms-2">
        <i class="bi bi-save"></i> Lưu
    </button>

    <a asp-area="Admin"
       asp-controller="Order"
       asp-action="Index"
       class="btn btn-secondary ms-2">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</form>

<hr />

<h4><i class="bi bi-bag"></i> Sản phẩm trong đơn</h4>

<table class="table table-bordered align-middle">
    <thead class="table-light">
    <tr>
        <th>Tên sản phẩm</th>
        <th class="text-center">Số lượng</th>
        <th class="text-end">Giá</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var i in Model.OrderDetails)
    {
        <tr>
            <td>@i.ProductVariant?.Product?.Name</td>
            <td class="text-center">@i.Quantity</td>
            <td class="text-end">@String.Format("{0:N0} VND", i.Price)</td>
        </tr>
    }
    </tbody>
</table>

<hr />

<h5><i class="bi bi-exclamation-triangle"></i> Xóa đơn hàng</h5>
<form asp-area="Admin"
      asp-controller="Order"
      asp-action="DeleteConfirmed"
      method="post"
      onsubmit="return confirm('Bạn có chắc chắn muốn xóa đơn hàng này?');">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">
        <i class="bi bi-trash3"></i> Xóa đơn hàng
    </button>
</form>
