@model List<WebBanHangOnline.Models.SupportRequest>

<h3>Yêu cầu hỗ trợ</h3>

<table class="table table-bordered">
    <thead>
    <tr>
        <th>Ngày</th>
        <th>Họ tên</th>
        <th>Email</th>
        <th>Nội dung</th>
        <th>Trạng thái</th>
        <th width="220"></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td>@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@r.FullName</td>
            <td>@r.Email</td>
            <td>@r.Message</td>
            <td>
                <span class="badge 
                        @(r.Status == "New" ? "bg-warning" :
                        r.Status == "InProgress" ? "bg-primary" : "bg-success")">
                    @r.Status
                </span>
            </td>
            <td>
                <a href="#"
                   class="btn btn-sm btn-info"
                   onclick="event.preventDefault(); document.getElementById('request-progress-@r.SupportRequestId').submit();">
                    Đang xử lý
                </a>
                <form id="request-progress-@r.SupportRequestId" asp-action="UpdateStatus" method="post" class="d-none">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@r.SupportRequestId" />
                    <input type="hidden" name="status" value="InProgress" />
                </form>

                <a href="#"
                   class="btn btn-sm btn-success"
                   onclick="event.preventDefault(); document.getElementById('request-done-@r.SupportRequestId').submit();">
                    Hoàn thành
                </a>
                <form id="request-done-@r.SupportRequestId" asp-action="UpdateStatus" method="post" class="d-none">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@r.SupportRequestId" />
                    <input type="hidden" name="status" value="Done" />
                </form>

                <a href="#"
                   class="btn btn-sm btn-danger"
                   onclick="event.preventDefault(); if (confirm('Xoá yêu cầu này?')) document.getElementById('delete-request-@r.SupportRequestId').submit();">
                    Xoá
                </a>
                <form id="delete-request-@r.SupportRequestId" asp-action="DeleteRequest" method="post" class="d-none">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@r.SupportRequestId" />
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
