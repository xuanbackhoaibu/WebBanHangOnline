@model List<WebBanHangOnline.Models.SupportFaq>

@{
    ViewData["Title"] = "FAQ";
}

<h3>Quản lý FAQ</h3>

<a asp-action="CreateFaq" class="btn btn-primary mb-3">
    + Thêm FAQ
</a>

@if (TempData["success"] != null)
{
    <div class="alert alert-success">
        @TempData["success"]
    </div>
}

<table class="table table-bordered">
    <thead>
    <tr>
        <th>Câu hỏi</th>
        <th>Hiển thị</th>
        <th width="180"></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var f in Model)
    {
        <tr>
            <td>@f.Question</td>
            <td>
                @if (f.IsActive)
                {
                    <span class="badge bg-success">ON</span>
                }
                else
                {
                    <span class="badge bg-secondary">OFF</span>
                }
            </td>
            <td>
                <a asp-action="EditFaq" asp-route-id="@f.SupportFaqId" class="btn btn-sm btn-warning">
                    Sửa
                </a>

                <a href="#"
                   class="btn btn-sm btn-info"
                   onclick="event.preventDefault(); document.getElementById('toggle-faq-@f.SupportFaqId').submit();">
                    Bật / Tắt
                </a>
                <form id="toggle-faq-@f.SupportFaqId" asp-action="ToggleFaq" method="post" class="d-none">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@f.SupportFaqId" />
                </form>

                <a href="#"
                   class="btn btn-sm btn-danger"
                   onclick="event.preventDefault(); if (confirm('Xoá FAQ này?')) document.getElementById('delete-faq-@f.SupportFaqId').submit();">
                    Xoá
                </a>
                <form id="delete-faq-@f.SupportFaqId" asp-action="DeleteFaq" method="post" class="d-none">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@f.SupportFaqId" />
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
