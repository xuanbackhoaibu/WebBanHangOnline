@{
Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/pages/admin-dashboard.css" asp-append-version="true" />
}
@{
// Tính toán các chỉ số phụ với kiểm tra null
var totalOrders = 0;
var totalRevenue = 0m;
var totalUsers = 0;
var totalProducts = 0;

try
{
totalOrders = ViewBag.TotalOrders as int? ?? 0;
totalRevenue = ViewBag.TotalRevenue as decimal? ?? 0;
totalUsers = ViewBag.TotalUsers as int? ?? 0;
totalProducts = ViewBag.TotalProducts as int? ?? 0;
}
catch
{
// Bỏ qua lỗi
}
}

<div class="dashboard-header">
    <h2><i class="fas fa-chart-pie me-2"></i>Dashboard Overview</h2>
    <div class="date-picker" id="refreshButton">
        <i class="far fa-calendar-alt"></i>
        <span>@DateTime.Now.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))</span>
        <i class="fas fa-sync-alt ms-2 admin-icon-sm"></i>
        <span class="refresh-badge"></span>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon orders">
            <i class="fas fa-shopping-cart"></i>
        </div>
        <div class="stat-content">
            <h5>Tổng đơn hàng</h5>
            <div class="stat-value" id="totalOrders">@totalOrders.ToString("N0")</div>
            <div class="stat-trend">
                <i class="fas fa-chart-line"></i>
                <span>Tổng số đơn hàng</span>
            </div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon revenue">
            <i class="fas fa-dollar-sign"></i>
        </div>
        <div class="stat-content">
            <h5>Tổng doanh thu</h5>
            <div class="stat-value" id="totalRevenue">@String.Format("{0:N0}", totalRevenue) VND</div>
            <div class="stat-trend">
                <i class="fas fa-chart-line"></i>
                <span>Đã thanh toán</span>
            </div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon users">
            <i class="fas fa-users"></i>
        </div>
        <div class="stat-content">
            <h5>Tổng người dùng</h5>
            <div class="stat-value" id="totalUsers">@totalUsers.ToString("N0")</div>
            <div class="stat-trend">
                <i class="fas fa-chart-line"></i>
                <span>Tổng tài khoản</span>
            </div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon products">
            <i class="fas fa-box"></i>
        </div>
        <div class="stat-content">
            <h5>Tổng sản phẩm</h5>
            <div class="stat-value" id="totalProducts">@totalProducts.ToString("N0")</div>
            <div class="stat-trend">
                <i class="fas fa-chart-line"></i>
                <span>Đang bán</span>
            </div>
        </div>
    </div>
</div>

<div class="charts-row">
    <div class="chart-card">
        <div class="chart-header">
            <h4><i class="fas fa-chart-line me-2 admin-icon-blue"></i>Doanh thu 7 ngày gần nhất</h4>
        </div>
        <div class="chart-container" id="revenueChartContainer">
            <canvas id="revenueChart"></canvas>
        </div>
    </div>

    <div class="chart-card">
        <div class="chart-header">
            <h4><i class="fas fa-chart-pie me-2 admin-icon-pink"></i>Phân bố đơn hàng</h4>
        </div>
        <div class="chart-container" id="orderDistributionContainer">
            <canvas id="orderDistributionChart"></canvas>
        </div>
    </div>
</div>

<div class="recent-orders">
    <div class="table-header">
        <h4><i class="fas fa-history me-2 admin-icon-blue"></i>Đơn hàng gần đây</h4>
        <a href="@Url.Action("Index", "Order", new { area = "Admin" })" class="view-all">
            Xem tất cả <i class="fas fa-arrow-right"></i>
        </a>
    </div>

    @{
    IEnumerable<dynamic> recentOrdersList = null;
    bool hasRecentOrders = false;

    try
    {
    recentOrdersList = ViewBag.RecentOrders as IEnumerable<dynamic>;
    hasRecentOrders = recentOrdersList != null && recentOrdersList.Any();
    }
    catch
    {
    hasRecentOrders = false;
    }
    }

    @if (hasRecentOrders)
    {
    <table class="order-table">
        <tbody>
        @foreach (var order in recentOrdersList)
        {
        // Tạo initials từ tên khách hàng
        string initials = "KH";
        string customerName = "Khách hàng";
        string customerEmail = "";

        try
        {
        customerName = order.CustomerName ?? "Khách hàng";
        customerEmail = order.CustomerEmail ?? "";

        if (!string.IsNullOrEmpty(customerName) && customerName != "Khách vãng lai")
        {
        var nameParts = customerName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (nameParts.Length > 1)
        {
        string firstInitial = nameParts[0].Length > 0 ? nameParts[0][0].ToString() : "";
        string lastInitial = nameParts[nameParts.Length - 1].Length > 0 ? nameParts[nameParts.Length - 1][0].ToString() : "";
        initials = (firstInitial + lastInitial).ToUpper();

        if (string.IsNullOrEmpty(initials))
        {
        initials = "KH";
        }
        }
        else if (customerName.Length >= 2)
        {
        initials = customerName.Substring(0, 2).ToUpper();
        }
        else if (customerName.Length >= 1)
        {
        initials = customerName.Substring(0, 1).ToUpper();
        }
        }
        }
        catch
        {
        initials = "KH";
        }

        // Xác định class cho status badge
        string statusClass = "status-pending";
        string statusText = "Chờ xử lý";

        try
        {
        statusText = order.Status ?? "Pending";
        string statusLower = statusText.ToLower();

        if (statusLower.Contains("giao") || statusLower.Contains("completed") || statusLower.Contains("paid") || statusLower.Contains("delivered") || statusLower.Contains("hoàn thành"))
        {
        statusClass = "status-delivered";
        statusText = "Đã hoàn thành";
        }
        else if (statusLower.Contains("hủy") || statusLower.Contains("cancelled"))
        {
        statusClass = "status-cancelled";
        statusText = "Đã hủy";
        }
        else if (statusLower.Contains("xử lý") || statusLower.Contains("processing") || statusLower.Contains("xác nhận"))
        {
        statusClass = "status-processing";
        statusText = "Đang xử lý";
        }
        else if (statusLower.Contains("vận chuyển") || statusLower.Contains("shipping"))
        {
        statusClass = "status-processing";
        statusText = "Đang vận chuyển";
        }
        else if (statusLower.Contains("pending") || statusLower.Contains("chờ"))
        {
        statusClass = "status-pending";
        statusText = "Đang chờ";
        }
        }
        catch
        {
        statusClass = "status-pending";
        statusText = "Chờ xử lý";
        }

        <tr>
            <td>
                <div class="avatar-group">
                    <div class="avatar">@initials</div>
                    <div class="user-info">
                        <span class="user-name">@customerName</span>
                        <span class="user-email">@(!string.IsNullOrEmpty(customerEmail) ? customerEmail : "Chưa có email")</span>
                    </div>
                </div>
            </td>
            <td>
                @try
                {
                string orderCode = order.OrderCode ?? "ORD" + order.Id.ToString("D6");
                <span>#@orderCode</span>
                }
                catch
                {
                <span>#ORD-000</span>
                }
            </td>
            <td>
                @try
                {
                decimal amount = order.TotalAmount is decimal ? (decimal)order.TotalAmount : 0;
                @String.Format("{0:N0}", amount) <span>VND</span>
                }
                catch
                {
                <span>0 VND</span>
                }
            </td>
            <td><span class="status-badge @statusClass">@statusText</span></td>
            <td>
                @try
                {
                string orderDate = order.OrderDate is DateTime ? ((DateTime)order.OrderDate).ToString("dd/MM/yyyy HH:mm") : "N/A";
                @orderDate
                }
                catch
                {
                <span>N/A</span>
                }
            </td>
            <td>
                <div class="action-buttons">
                    @{
                    int orderId = 0;
                    try
                    {
                    orderId = order.Id is int ? (int)order.Id : 0;
                    }
                    catch
                    {
                    orderId = 0;
                    }
                    }
                    <button class="btn-icon" onclick="viewOrderDetail(@orderId)" title="Xem chi tiết">
                        <i class="fas fa-eye"></i>
                    </button>
                    <button class="btn-icon" onclick="editOrder(@orderId)" title="Chỉnh sửa">
                        <i class="fas fa-edit"></i>
                    </button>
                </div>
            </td>
        </tr>
        }
        </tbody>
    </table>
    }
    else
    {
    <div class="empty-state">
        <i class="fas fa-shopping-cart"></i>
        <p>Chưa có đơn hàng nào</p>
    </div>
    }
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // Format số tiền VNĐ
    function formatCurrency(value) {
        try {
            return new Intl.NumberFormat('vi-VN', {
                style: 'currency',
                currency: 'VND'
            }).format(value);
        } catch (e) {
            return value + ' VND';
        }
    }

    // Biến toàn cục lưu trữ biểu đồ
    let revenueChart = null;
    let distributionChart = null;

    // Dữ liệu từ server
    @{
    var revenueLabelsJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartLabels ?? new List<string>());
    var revenueDataJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartData ?? new List<decimal>());
    var statusLabelsJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.OrderStatusLabels ?? new List<string>());
    var statusDataJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.OrderStatusData ?? new List<int>());
    }

    // Hàm vẽ biểu đồ doanh thu
    function renderRevenueChart(labels, data) {
        const ctx = document.getElementById('revenueChart');
        if (!ctx) return;

        // Hủy biểu đồ cũ nếu có
        if (revenueChart) {
            revenueChart.destroy();
        }

        if (labels && labels.length > 0) {
            revenueChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh thu',
                        data: data,
                        borderColor: '#667eea',
                        backgroundColor: 'rgba(102, 126, 234, 0.1)',
                        borderWidth: 3,
                        tension: 0.3,
                        fill: true,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#667eea',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return formatCurrency(context.raw);
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#e2e8f0' },
                            ticks: {
                                callback: function(value) {
                                    if (value >= 1000000) return (value / 1000000).toFixed(1) + 'tr';
                                    if (value >= 1000) return (value / 1000).toFixed(0) + 'k';
                                    return value;
                                }
                            }
                        }
                    }
                }
            });

            // Kiểm tra và thông báo nếu có doanh thu
            const totalRevenue = data.reduce((sum, val) => sum + val, 0);
            if (totalRevenue > 0) {
                console.log('✅ Biểu đồ doanh thu đã vẽ với dữ liệu:', data);

                // Highlight ngày có doanh thu
                const revenueDates = labels.filter((_, index) => data[index] > 0);
                if (revenueDates.length > 0) {
                    console.log('📅 Các ngày có doanh thu:', revenueDates.join(', '));
                }
            }
        }
    }

    // Hàm vẽ biểu đồ phân bố
    function renderDistributionChart(labels, data) {
        const ctx = document.getElementById('orderDistributionChart');
        if (!ctx) return;

        // Hủy biểu đồ cũ nếu có
        if (distributionChart) {
            distributionChart.destroy();
        }

        if (labels && labels.length > 0 && data && data.length > 0) {
            const colors = ['#10b981', '#f59e0b', '#ef4444', '#3b82f6', '#8b5cf6', '#ec4899', '#14b8a6', '#64748b'];

            distributionChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: colors.slice(0, labels.length),
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                usePointStyle: true,
                                padding: 15,
                                font: { size: 11 }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const label = context.label || '';
                                    const value = context.raw || 0;
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = total > 0 ? Math.round((value / total) * 100) : 0;
                                    return `${label}: ${value} VNDơn (${percentage}%)`;
                                }
                            }
                        }
                    },
                    cutout: '65%'
                }
            });

            console.log('✅ Biểu đồ phân bố đã vẽ với dữ liệu:', data);
        }
    }

    // Hàm tải lại dữ liệu từ server
    async function refreshData() {
        const refreshButton = document.getElementById('refreshButton');
        refreshButton.classList.add('refreshing');

        try {
            // Gọi API để lấy dữ liệu mới
            const response = await fetch('@Url.Action("GetDashboardData", "Dashboard")');
            const data = await response.json();

            if (data.success) {
                // Cập nhật số liệu thống kê
                document.getElementById('totalOrders').textContent = data.totalOrders.toLocaleString('vi-VN');
                document.getElementById('totalRevenue').textContent = formatCurrency(data.totalRevenue);
                document.getElementById('totalUsers').textContent = data.totalUsers.toLocaleString('vi-VN');
                document.getElementById('totalProducts').textContent = data.totalProducts.toLocaleString('vi-VN');

                // Vẽ lại biểu đồ với dữ liệu mới
                renderRevenueChart(data.revenueLabels, data.revenueData);
                renderDistributionChart(data.statusLabels, data.statusData);

                console.log('🔄 Đã cập nhật dữ liệu mới:', new Date().toLocaleTimeString());
            }
        } catch (error) {
            console.error('Lỗi khi tải dữ liệu:', error);
        } finally {
            refreshButton.classList.remove('refreshing');
        }
    }

    // Khởi tạo khi trang load
    document.addEventListener('DOMContentLoaded', function() {
        console.log('========== KHỞI TẠO BIỂU ĐỒ ==========');

        // Parse dữ liệu từ server
        const revenueLabels = @Html.Raw(revenueLabelsJson);
        const revenueData = @Html.Raw(revenueDataJson);
        const statusLabels = @Html.Raw(statusLabelsJson);
        const statusData = @Html.Raw(statusDataJson);

        console.log('Dữ liệu doanh thu:', revenueData);
        console.log('Dữ liệu phân bố:', statusData);

        // Vẽ biểu đồ lần đầu
        renderRevenueChart(revenueLabels, revenueData);
        renderDistributionChart(statusLabels, statusData);

        // Thiết lập tự động refresh mỗi 30 giây
        setInterval(refreshData, 30000); // 30 giây

        // Click để refresh thủ công
        document.getElementById('refreshButton').addEventListener('click', function(e) {
            e.preventDefault();
            refreshData();
        });

        console.log('✅ Khởi tạo hoàn tất - Tự động refresh mỗi 30 giây');
    });

    // Hàm xem chi tiết đơn hàng
    function viewOrderDetail(orderId) {
        if (orderId && orderId > 0) {
            window.location.href = '@Url.Action("Details", "Order", new { area = "Admin" })' + '?id=' + orderId;
        }
    }

    // Hàm chỉnh sửa đơn hàng
    function editOrder(orderId) {
        if (orderId && orderId > 0) {
            window.location.href = '@Url.Action("Edit", "Order", new { area = "Admin" })' + '?id=' + orderId;
        }
    }
</script>
}
