@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";

    var totalOrders = ViewBag.TotalOrders as int? ?? 0;
    var totalRevenue = ViewBag.TotalRevenue as decimal? ?? 0;
    var totalUsers = ViewBag.TotalUsers as int? ?? 0;
    var totalProducts = ViewBag.TotalProducts as int? ?? 0;
    var todayOrders = ViewBag.TodayOrders as int? ?? 0;
    var todayRevenue = ViewBag.TodayRevenue as decimal? ?? 0;
    var currentRevenueMonth = ViewBag.CurrentRevenueMonth as string ?? DateTime.Today.ToString("yyyy-MM");

    var recentOrdersList = ViewBag.RecentOrders as IEnumerable<dynamic>;
    var lowStockVariants = ViewBag.LowStockVariants as IEnumerable<dynamic>;
    var rfmSegments = ViewBag.RfmSegments as IEnumerable<dynamic>;
    dynamic cartAbandonment = ViewBag.CartAbandonment;
    var cohortRows = ViewBag.CohortRows as IEnumerable<dynamic>;

    string StatusClass(string status)
    {
        status = status ?? string.Empty;
        if (status == "Paid" || status == "Completed" || status == "Delivered") return "status-completed";
        if (status == "Unpaid" || status == "Pending") return "status-pending";
        if (status == "Cancelled" || status == "Failed") return "status-cancelled";
        if (status == "Shipping" || status == "Confirmed" || status == "Processing") return "status-processing";
        return "status-pending";
    }

    string DisplayStatus(string status)
    {
        return status switch
        {
            "Pending" => "Đang chờ",
            "Confirmed" => "Đã xác nhận",
            "Shipping" => "Đang giao",
            "Completed" => "Hoàn thành",
            "Cancelled" => "Đã hủy",
            "Unpaid" => "Chưa thanh toán",
            "Paid" => "Đã thanh toán",
            "Failed" => "Thất bại",
            "Refunded" => "Đã hoàn tiền",
            _ => "Đang chờ"
        };
    }
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/pages/admin-dashboard.css" asp-append-version="true" />
}

<div class="dashboard-header">
    <div>
        <p class="dashboard-kicker">Admin</p>
        <h2>Tổng quan cửa hàng</h2>
    </div>
    <button type="button" class="date-picker" id="refreshButton">
        <i class="fas fa-sync-alt"></i>
        <span>@DateTime.Now.ToString("dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))</span>
        <span class="refresh-badge"></span>
    </button>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon orders"><i class="fas fa-receipt"></i></div>
        <div class="stat-content">
            <h5>Tổng đơn</h5>
            <div class="stat-value" id="totalOrders">@totalOrders.ToString("N0")</div>
            <div class="stat-trend">@todayOrders.ToString("N0") đơn hôm nay</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon revenue"><i class="fas fa-coins"></i></div>
        <div class="stat-content">
            <h5>Doanh thu</h5>
            <div class="stat-value" id="totalRevenue">@String.Format("{0:N0}", totalRevenue) VND</div>
            <div class="stat-trend">@String.Format("{0:N0}", todayRevenue) VND hôm nay</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon users"><i class="fas fa-user-group"></i></div>
        <div class="stat-content">
            <h5>Người dùng</h5>
            <div class="stat-value" id="totalUsers">@totalUsers.ToString("N0")</div>
            <div class="stat-trend">Tài khoản đã tạo</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon products"><i class="fas fa-box-open"></i></div>
        <div class="stat-content">
            <h5>Sản phẩm</h5>
            <div class="stat-value" id="totalProducts">@totalProducts.ToString("N0")</div>
            <div class="stat-trend">Mặt hàng đang bán</div>
        </div>
    </div>
</div>

<div class="bi-grid">
    <section class="chart-card bi-card">
        <div class="chart-header">
            <div>
                <h4>RFM khách hàng</h4>
                <span>Phân nhóm theo Recency, Frequency, Monetary</span>
            </div>
        </div>
        <div class="rfm-list" id="rfmList">
            @if (rfmSegments != null && rfmSegments.Any())
            {
                @foreach (var segment in rfmSegments)
                {
                    <div class="rfm-item">
                        <div>
                            <strong>@segment.Segment</strong>
                            <span>R @segment.AverageRecencyDays ngày · F @segment.AverageFrequency</span>
                        </div>
                        <div>
                            <b>@segment.CustomerCount</b>
                            <span>@String.Format("{0:N0}", segment.TotalMonetary) VND</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state compact"><p>Chưa đủ dữ liệu RFM</p></div>
            }
        </div>
    </section>

    <section class="chart-card bi-card">
        <div class="chart-header">
            <div>
                <h4>Bỏ giỏ hàng</h4>
                <span>Người đã thêm giỏ nhưng chưa checkout</span>
            </div>
        </div>
        <div class="abandonment-metric">
            <div class="abandonment-rate" id="abandonmentRate">@String.Format("{0:N1}", cartAbandonment?.AbandonmentRate ?? 0)%</div>
            <div class="abandonment-bars">
                <div>
                    <span>Giỏ bỏ lại</span>
                    <b id="abandonedCartUsers">@(cartAbandonment?.AbandonedCartUsers ?? 0)</b>
                </div>
                <div>
                    <span>Checkout 30 ngày</span>
                    <b id="recentCheckoutUsers">@(cartAbandonment?.RecentCheckoutUsers ?? 0)</b>
                </div>
            </div>
        </div>
    </section>

    <section class="chart-card bi-card bi-card-wide">
        <div class="chart-header">
            <div>
                <h4>Cohort quay lại mua</h4>
                <span>Tỷ lệ khách trong cohort mua lại theo tháng</span>
            </div>
        </div>
        <div class="cohort-table-wrap">
            <table class="cohort-table" id="cohortTable">
                <thead>
                    <tr>
                        <th>Cohort</th>
                        <th>KH</th>
                        <th>M0</th>
                        <th>M1</th>
                        <th>M2</th>
                        <th>M3</th>
                        <th>M4</th>
                        <th>M5</th>
                    </tr>
                </thead>
                <tbody>
                    @if (cohortRows != null && cohortRows.Any())
                    {
                        @foreach (var row in cohortRows)
                        {
                            <tr>
                                <td>@row.CohortMonth</td>
                                <td>@row.CustomerCount</td>
                                @foreach (var rate in row.RetentionRates)
                                {
                                    <td><span class="cohort-cell" style="--heat:@((decimal)rate / 100m)">@String.Format("{0:N0}", rate)%</span></td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="8">Chưa đủ dữ liệu cohort</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

<div class="dashboard-grid">
    <section class="chart-card chart-card-wide">
        <div class="chart-header">
            <div>
                <h4 id="revenueChartTitle">Doanh thu 7 ngày</h4>
                <span id="revenueChartSubtitle">Đơn đã thanh toán hoặc đã xác nhận</span>
            </div>
            <div class="chart-actions" aria-label="Chọn khoảng doanh thu">
                <div class="segmented-control">
                    <button type="button" class="active" data-revenue-mode="7days">7 ngày</button>
                    <button type="button" data-revenue-mode="month">Tháng</button>
                </div>
                <input type="month" id="revenueMonthInput" class="month-input" value="@currentRevenueMonth" hidden />
            </div>
        </div>
        <div class="chart-container">
            <canvas id="revenueChart"></canvas>
        </div>
    </section>

    <section class="chart-card">
        <div class="chart-header">
            <h4>Trạng thái đơn</h4>
            <span>Theo số lượng</span>
        </div>
        <div class="chart-container">
            <canvas id="orderDistributionChart"></canvas>
        </div>
    </section>

    <section class="chart-card">
        <div class="chart-header">
            <h4>Thanh toán</h4>
            <span>Paid / unpaid / failed</span>
        </div>
        <div class="chart-container">
            <canvas id="paymentStatusChart"></canvas>
        </div>
    </section>

    <section class="chart-card chart-card-wide">
        <div class="chart-header">
            <h4>Doanh thu theo danh mục</h4>
            <span>Top danh mục có doanh thu</span>
        </div>
        <div class="chart-container">
            <canvas id="categorySalesChart"></canvas>
        </div>
    </section>
</div>

<div class="dashboard-lower-grid">
    <section class="recent-orders">
        <div class="table-header">
            <div>
                <h4>Đơn hàng mới</h4>
                <span>Chỉ hiện 5 đơn gần nhất</span>
            </div>
            <a href="@Url.Action("Index", "Order", new { area = "Admin" })" class="view-all">
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>

        @if (recentOrdersList != null && recentOrdersList.Any())
        {
            <table class="order-table">
                <thead>
                    <tr>
                        <th>Đơn</th>
                        <th>Khách</th>
                        <th>Tiền</th>
                        <th>TT đơn</th>
                        <th>TT tiền</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in recentOrdersList)
                    {
                        var orderCode = order.OrderCode ?? $"ORD{order.Id:D6}";
                        var customerName = order.CustomerName ?? "Khách hàng";
                        var amount = order.TotalAmount is decimal ? (decimal)order.TotalAmount : 0m;
                        var status = order.Status ?? "";
                        var paymentStatus = order.PaymentStatus ?? "";
                        var orderDate = order.OrderDate is DateTime ? ((DateTime)order.OrderDate).ToString("dd/MM HH:mm") : "";

                        <tr>
                            <td>
                                <strong>#@orderCode</strong>
                                <span>@orderDate</span>
                            </td>
                            <td>@customerName</td>
                            <td>@String.Format("{0:N0}", amount)</td>
                            <td><span class="status-badge @StatusClass(status)">@DisplayStatus(status)</span></td>
                            <td><span class="status-badge @StatusClass(paymentStatus)">@DisplayStatus(paymentStatus)</span></td>
                            <td>
                                <button class="btn-icon" onclick="viewOrderDetail(@order.Id)" title="Xem chi tiết">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-receipt"></i>
                <p>Chưa có đơn hàng nào</p>
            </div>
        }
    </section>

    <section class="recent-orders">
        <div class="table-header">
            <div>
                <h4>Sắp hết hàng</h4>
                <span>Biến thể cần kiểm tra kho</span>
            </div>
            <a href="@Url.Action("Index", "Product", new { area = "Admin" })" class="view-all">
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>

        @if (lowStockVariants != null && lowStockVariants.Any())
        {
            <div class="stock-list">
                @foreach (var item in lowStockVariants)
                {
                    <div class="stock-item">
                        <div>
                            <strong>@item.ProductName</strong>
                            <span>@item.Size / @item.Color</span>
                        </div>
                        <span class="stock-count">@item.Stock</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-box-open"></i>
                <p>Chưa có dữ liệu kho</p>
            </div>
        }
    </section>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

<script>
    const moneyFormatter = new Intl.NumberFormat('vi-VN', {
        style: 'currency',
        currency: 'VND',
        maximumFractionDigits: 0
    });

    const palette = ['#b94132', '#252525', '#b08a2e', '#4b7f8c', '#74685d', '#6f5f9f'];
    const mutedGrid = '#ece7e1';
    let revenueChart;
    let distributionChart;
    let paymentStatusChart;
    let categorySalesChart;
    let selectedRevenueMode = '7days';
    let audioContext;

    @{
        var revenueLabelsJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartLabels ?? new List<string>());
        var revenueDataJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartData ?? new List<decimal>());
        var statusLabelsJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.OrderStatusLabels ?? new List<string>());
        var statusDataJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.OrderStatusData ?? new List<int>());
        var paymentLabelsJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.PaymentStatusLabels ?? new List<string>());
        var paymentDataJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.PaymentStatusData ?? new List<int>());
        var categoryLabelsJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.CategorySalesLabels ?? new List<string>());
        var categoryDataJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.CategorySalesData ?? new List<decimal>());
    }

    function buildEmptyState(canvas, message) {
        const container = canvas.closest('.chart-container');
        if (!container || container.querySelector('.chart-empty')) return;
        const empty = document.createElement('div');
        empty.className = 'chart-empty';
        empty.textContent = message;
        container.appendChild(empty);
    }

    function clearEmptyState(canvas) {
        const empty = canvas.closest('.chart-container')?.querySelector('.chart-empty');
        if (empty) empty.remove();
    }

    function renderLineChart(labels, data) {
        const canvas = document.getElementById('revenueChart');
        if (!canvas) return;
        revenueChart?.destroy();

        if (!labels?.length) {
            buildEmptyState(canvas, 'Chưa có doanh thu');
            return;
        }

        clearEmptyState(canvas);
        revenueChart = new Chart(canvas, {
            type: 'line',
            data: {
                labels,
                datasets: [{
                    data,
                    borderColor: '#b94132',
                    backgroundColor: 'rgba(185, 65, 50, 0.08)',
                    borderWidth: 2,
                    pointRadius: 3,
                    pointBackgroundColor: '#ffffff',
                    pointBorderColor: '#b94132',
                    tension: 0.25,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                layout: {
                    padding: {
                        bottom: 8
                    }
                },
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: context => moneyFormatter.format(context.raw || 0) } }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: {
                            autoSkip: selectedRevenueMode === 'month',
                            maxTicksLimit: selectedRevenueMode === 'month' ? 12 : 7,
                            maxRotation: 0,
                            minRotation: 0,
                            padding: 8
                        }
                    },
                    y: {
                        beginAtZero: true,
                        grid: { color: mutedGrid },
                        ticks: {
                            callback: value => value >= 1000000 ? `${(value / 1000000).toFixed(1)}tr` : value
                        }
                    }
                }
            }
        });
    }

    function renderDoughnutChart(chartRef, canvasId, labels, data) {
        const canvas = document.getElementById(canvasId);
        if (!canvas) return null;
        chartRef?.destroy();

        if (!labels?.length || !data?.length) {
            buildEmptyState(canvas, 'Chưa có dữ liệu');
            return null;
        }

        clearEmptyState(canvas);
        return new Chart(canvas, {
            type: 'doughnut',
            data: {
                labels,
                datasets: [{
                    data,
                    backgroundColor: palette.slice(0, labels.length),
                    borderColor: '#ffffff',
                    borderWidth: 2,
                    hoverOffset: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '68%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { usePointStyle: true, boxWidth: 8, padding: 12, font: { size: 11 } }
                    },
                    tooltip: {
                        callbacks: {
                            label: context => {
                                const total = context.dataset.data.reduce((sum, value) => sum + value, 0);
                                const percent = total > 0 ? Math.round((context.raw / total) * 100) : 0;
                                return `${context.label}: ${context.raw} (${percent}%)`;
                            }
                        }
                    }
                }
            }
        });
    }

    function renderBarChart(labels, data) {
        const canvas = document.getElementById('categorySalesChart');
        if (!canvas) return;
        categorySalesChart?.destroy();

        if (!labels?.length || !data?.length) {
            buildEmptyState(canvas, 'Chưa có doanh thu theo danh mục');
            return;
        }

        clearEmptyState(canvas);
        categorySalesChart = new Chart(canvas, {
            type: 'bar',
            data: {
                labels,
                datasets: [{
                    data,
                    backgroundColor: '#4b7f8c',
                    borderRadius: 4,
                    maxBarThickness: 34
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: context => moneyFormatter.format(context.raw || 0) } }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: {
                        beginAtZero: true,
                        grid: { color: mutedGrid },
                        ticks: {
                            callback: value => value >= 1000000 ? `${(value / 1000000).toFixed(1)}tr` : value
                        }
                    }
                }
            }
        });
    }

    function renderAllCharts(data) {
        renderLineChart(data.revenueLabels, data.revenueData);
        distributionChart = renderDoughnutChart(distributionChart, 'orderDistributionChart', data.statusLabels, data.statusData);
        paymentStatusChart = renderDoughnutChart(paymentStatusChart, 'paymentStatusChart', data.paymentLabels, data.paymentData);
        renderBarChart(data.categoryLabels, data.categoryData);
    }

    function renderBusinessIntelligence(data) {
        if (!data) return;

        const rfmList = document.getElementById('rfmList');
        if (rfmList) {
            const segments = data.rfmSegments || [];
            rfmList.innerHTML = segments.length
                ? segments.map(segment => `
                    <div class="rfm-item">
                        <div>
                            <strong>${segment.segment}</strong>
                            <span>R ${segment.averageRecencyDays} ngày · F ${segment.averageFrequency}</span>
                        </div>
                        <div>
                            <b>${segment.customerCount}</b>
                            <span>${moneyFormatter.format(segment.totalMonetary || 0)}</span>
                        </div>
                    </div>
                `).join('')
                : '<div class="empty-state compact"><p>Chưa đủ dữ liệu RFM</p></div>';
        }

        document.getElementById('abandonmentRate').textContent = `${Number(data.cartAbandonment?.abandonmentRate || 0).toFixed(1)}%`;
        document.getElementById('abandonedCartUsers').textContent = data.cartAbandonment?.abandonedCartUsers || 0;
        document.getElementById('recentCheckoutUsers').textContent = data.cartAbandonment?.recentCheckoutUsers || 0;

        const cohortBody = document.querySelector('#cohortTable tbody');
        if (cohortBody) {
            const rows = data.cohortRows || [];
            cohortBody.innerHTML = rows.length
                ? rows.map(row => `
                    <tr>
                        <td>${row.cohortMonth}</td>
                        <td>${row.customerCount}</td>
                        ${(row.retentionRates || []).map(rate => `<td><span class="cohort-cell" style="--heat:${Number(rate) / 100}">${Number(rate).toFixed(0)}%</span></td>`).join('')}
                    </tr>
                `).join('')
                : '<tr><td colspan="8">Chưa đủ dữ liệu cohort</td></tr>';
        }
    }

    function playOrderBell() {
        try {
            audioContext = audioContext || new (window.AudioContext || window.webkitAudioContext)();
            const oscillator = audioContext.createOscillator();
            const gain = audioContext.createGain();
            oscillator.type = 'sine';
            oscillator.frequency.setValueAtTime(880, audioContext.currentTime);
            oscillator.frequency.setValueAtTime(660, audioContext.currentTime + 0.12);
            gain.gain.setValueAtTime(0.05, audioContext.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, audioContext.currentTime + 0.45);
            oscillator.connect(gain);
            gain.connect(audioContext.destination);
            oscillator.start();
            oscillator.stop(audioContext.currentTime + 0.45);
        } catch {
        }
    }

    function showAdminToast(order) {
        const toast = document.createElement('div');
        toast.className = 'admin-live-toast';
        toast.innerHTML = `
            <div class="toast-icon"><i class="fas fa-bell"></i></div>
            <div>
                <strong>Đơn mới ${order.orderCode}</strong>
                <span>${order.customerName} · ${moneyFormatter.format(order.totalAmount || 0)}</span>
            </div>
        `;
        document.body.appendChild(toast);
        setTimeout(() => toast.classList.add('show'), 20);
        setTimeout(() => {
            toast.classList.remove('show');
            setTimeout(() => toast.remove(), 240);
        }, 5200);
    }

    async function refreshData() {
        const refreshButton = document.getElementById('refreshButton');
        refreshButton?.classList.add('refreshing');

        try {
            const monthInput = document.getElementById('revenueMonthInput');
            const url = new URL('@Url.Action("GetDashboardData", "Dashboard", new { area = "Admin" })', window.location.origin);
            url.searchParams.set('revenueMode', selectedRevenueMode);

            if (selectedRevenueMode === 'month' && monthInput?.value) {
                url.searchParams.set('month', monthInput.value);
            }

            const response = await fetch(url.toString());
            const data = await response.json();

            if (!data.success) return;

            document.getElementById('totalOrders').textContent = data.totalOrders.toLocaleString('vi-VN');
            document.getElementById('totalRevenue').textContent = moneyFormatter.format(data.totalRevenue);
            document.getElementById('totalUsers').textContent = data.totalUsers.toLocaleString('vi-VN');
            document.getElementById('totalProducts').textContent = data.totalProducts.toLocaleString('vi-VN');
            renderAllCharts(data);
            renderBusinessIntelligence(data.businessIntelligence);
        } catch (error) {
            console.error('Lỗi khi tải dashboard:', error);
        } finally {
            refreshButton?.classList.remove('refreshing');
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        renderAllCharts({
            revenueLabels: @Html.Raw(revenueLabelsJson),
            revenueData: @Html.Raw(revenueDataJson),
            statusLabels: @Html.Raw(statusLabelsJson),
            statusData: @Html.Raw(statusDataJson),
            paymentLabels: @Html.Raw(paymentLabelsJson),
            paymentData: @Html.Raw(paymentDataJson),
            categoryLabels: @Html.Raw(categoryLabelsJson),
            categoryData: @Html.Raw(categoryDataJson)
        });

        document.querySelectorAll('[data-revenue-mode]').forEach(button => {
            button.addEventListener('click', function() {
                selectedRevenueMode = this.dataset.revenueMode || '7days';

                document.querySelectorAll('[data-revenue-mode]').forEach(item => {
                    item.classList.toggle('active', item === this);
                });

                const monthInput = document.getElementById('revenueMonthInput');
                const title = document.getElementById('revenueChartTitle');
                const subtitle = document.getElementById('revenueChartSubtitle');

                if (selectedRevenueMode === 'month') {
                    monthInput.hidden = false;
                    title.textContent = 'Doanh thu theo tháng';
                    subtitle.textContent = 'Từng ngày trong tháng đã chọn';
                } else {
                    monthInput.hidden = true;
                    title.textContent = 'Doanh thu 7 ngày';
                    subtitle.textContent = 'Đơn đã thanh toán hoặc đã xác nhận';
                }

                refreshData();
            });
        });

        document.getElementById('revenueMonthInput')?.addEventListener('change', refreshData);
        document.getElementById('refreshButton')?.addEventListener('click', refreshData);
        setInterval(refreshData, 30000);

        if (window.signalR) {
            const adminConnection = new signalR.HubConnectionBuilder()
                .withUrl('/adminNotificationHub')
                .withAutomaticReconnect()
                .build();

            adminConnection.on('OrderPlaced', order => {
                playOrderBell();
                showAdminToast(order);
                refreshData();
            });

            adminConnection.start().catch(error => console.error('Không kết nối được admin realtime:', error));
        }
    });

    function viewOrderDetail(orderId) {
        if (orderId && orderId > 0) {
            window.location.href = '@Url.Action("Details", "Order", new { area = "Admin" })' + '?id=' + orderId;
        }
    }
</script>
}
