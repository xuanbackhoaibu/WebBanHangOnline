<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">


    <!-- Custom Admin CSS -->
    <link rel="stylesheet" href="~/css/admin.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<!-- HEADER -->
<nav class="navbar admin-header">
    <div class="container-fluid">
        <span class="navbar-brand">
            🛒 ADMIN PANEL
        </span>

        <div class="d-flex align-items-center gap-3">
            <span class="small text-light opacity-75">
                Xin chào, Admin
            </span>

            <a class="btn btn-outline-light btn-sm"
               asp-area=""
               asp-controller="Home"
               asp-action="Index">
                <i class="bi bi-box-arrow-right"></i> Trang người dùng
            </a>
        </div>
    </div>
</nav>

<div class="container-fluid">
    <div class="row">

        <!-- SIDEBAR -->
        <div class="col-2 admin-sidebar p-3">
            <ul class="nav flex-column">

                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Dashboard" ? "active" : "")"
                       asp-area="Admin"
                       asp-controller="Dashboard"
                       asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Order" ? "active" : "")"
                       asp-area="Admin"
                       asp-controller="Order"
                       asp-action="Index">
                        <i class="bi bi-box-seam"></i> Quản lý đơn hàng
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Product" ? "active" : "")"
                       asp-area="Admin"
                       asp-controller="Product"
                       asp-action="Index">
                        <i class="bi bi-bag"></i> Quản lý sản phẩm
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="User" ? "active" : "")"
                       asp-area="Admin"
                       asp-controller="User"
                       asp-action="Index">
                        <i class="bi bi-people"></i> Quản lý người dùng
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Report" ? "active" : "")"
                       asp-area="Admin"
                       asp-controller="Report"
                       asp-action="Index">
                        <i class="bi bi-graph-up"></i> Báo cáo
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Notification" ? "active" : "")"
                       asp-area="Admin"
                       asp-controller="Notification"
                       asp-action="Index">
                        <i class="bi bi-bell"></i> Thông báo
                        <span class="badge-dot"></span>
                    </a>
                </li>

                <hr class="text-secondary my-2">

                <!-- SUPPORT -->
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Support" && ViewContext.RouteData.Values["action"]?.ToString()=="Faq" ? "active" : "")"
                       asp-area="Admin"
                       asp-controller="Support"
                       asp-action="Faq">
                        <i class="bi bi-question-circle"></i> FAQ hỗ trợ
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Support" && ViewContext.RouteData.Values["action"]?.ToString()=="Requests" ? "active" : "")"
                       asp-area="Admin"
                       asp-controller="Support"
                       asp-action="Requests">
                        <i class="bi bi-headset"></i> Yêu cầu hỗ trợ
                    </a>
                </li>

            </ul>
        </div>

        <!-- CONTENT -->
        <div class="col-10 p-4">
            <div class="content-wrapper">
                @RenderBody()
            </div>
        </div>

    </div>
</div>

<!-- ========================= -->
<!-- JS SCRIPTS -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
