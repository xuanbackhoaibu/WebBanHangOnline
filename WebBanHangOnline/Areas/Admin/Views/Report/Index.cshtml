@model WebBanHangOnline.Models.ViewModels.ReportIndexViewModel

@{
    ViewData["Title"] = "Báo cáo";
    var maxRevenue = Model.DailyRevenue.Any() ? Model.DailyRevenue.Max(item => item.Revenue) : 0;
    var today = DateTime.Today;
    var thisMonthStart = new DateTime(today.Year, today.Month, 1);
    var lastMonthDate = today.AddMonths(-1);
    var lastMonthStart = new DateTime(lastMonthDate.Year, lastMonthDate.Month, 1);
    var lastMonthEnd = thisMonthStart.AddDays(-1);

    string StatusText(string status) => status switch
    {
        "Pending" => "Chờ xử lý",
        "Confirmed" => "Đã xác nhận",
        "Shipping" => "Đang giao",
        "Completed" => "Hoàn thành",
        "Cancelled" => "Đã hủy",
        _ => status
    };
}

<div class="admin-page-head">
    <div>
        <h2><i class="bi bi-graph-up-arrow"></i> Báo cáo doanh thu</h2>
        <p>Tổng hợp doanh thu, thanh toán, giảm giá và sản phẩm bán chạy theo khoảng ngày.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="ExportExcel"
           asp-route-from="@Model.From"
           asp-route-to="@Model.To"
           class="btn btn-primary">
            <i class="bi bi-file-earmark-excel"></i> Xuất Excel
        </a>
        <a asp-action="ExportPdf"
           asp-route-from="@Model.From"
           asp-route-to="@Model.To"
           class="btn btn-outline-danger">
            <i class="bi bi-filetype-pdf"></i> Xuất PDF
        </a>
        <form asp-action="SendScheduledNow" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary">
                <i class="bi bi-send-check"></i> Gửi report email
            </button>
        </form>
    </div>
</div>

@if (TempData["ReportMessage"] != null)
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle"></i> @TempData["ReportMessage"]
    </div>
}

<form method="get" class="admin-filter-card mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-lg-3 col-md-6">
            <label class="form-label">Từ ngày</label>
            <input type="date" name="from" class="form-control" value="@Model.From" />
        </div>
        <div class="col-lg-3 col-md-6">
            <label class="form-label">Đến ngày</label>
            <input type="date" name="to" class="form-control" value="@Model.To" />
        </div>
        <div class="col-lg-3 col-md-6">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-funnel"></i> Lọc báo cáo
            </button>
        </div>
        <div class="col-lg-3 col-md-6">
            <a asp-action="Index" class="btn btn-outline-secondary w-100">
                <i class="bi bi-arrow-counterclockwise"></i> Xóa lọc
            </a>
        </div>
        <div class="col-12">
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Index"
                   asp-route-from="@today.AddDays(-6).ToString("yyyy-MM-dd")"
                   asp-route-to="@today.ToString("yyyy-MM-dd")"
                   class="btn btn-sm btn-outline-primary">7 ngày gần đây</a>
                <a asp-action="Index"
                   asp-route-from="@thisMonthStart.ToString("yyyy-MM-dd")"
                   asp-route-to="@today.ToString("yyyy-MM-dd")"
                   class="btn btn-sm btn-outline-primary">Tháng này</a>
                <a asp-action="Index"
                   asp-route-from="@lastMonthStart.ToString("yyyy-MM-dd")"
                   asp-route-to="@lastMonthEnd.ToString("yyyy-MM-dd")"
                   class="btn btn-sm btn-outline-primary">Tháng trước</a>
            </div>
        </div>
    </div>
</form>

<div class="admin-metric-grid mb-3">
    <div class="admin-metric-card is-primary">
        <span>Tổng doanh thu</span>
        <strong>@Model.TotalRevenue.ToString("N0") VND</strong>
    </div>
    <div class="admin-metric-card">
        <span>Tổng đơn hợp lệ</span>
        <strong>@Model.TotalOrders</strong>
    </div>
    <div class="admin-metric-card">
        <span>Giá trị trung bình</span>
        <strong>@Model.AverageOrderValue.ToString("N0") VND</strong>
    </div>
    <div class="admin-metric-card">
        <span>Đã giảm giá</span>
        <strong>@Model.TotalDiscount.ToString("N0") VND</strong>
    </div>
</div>

<div class="admin-report-grid">
    <section class="admin-report-card">
        <div class="admin-card-head">
            <div>
                <h5>Doanh thu theo ngày</h5>
                <span>@Model.DailyRevenue.Count ngày có doanh thu</span>
            </div>
        </div>

        @if (Model.DailyRevenue.Any())
        {
            <div class="admin-bar-chart">
                @foreach (var item in Model.DailyRevenue)
                {
                    var percent = maxRevenue > 0 ? Math.Max(6, (int)Math.Round(item.Revenue / maxRevenue * 100)) : 0;
                    <a class="admin-bar-row text-decoration-none"
                       asp-action="Details"
                       asp-route-date="@item.Date.ToString("yyyy-MM-dd")"
                       title="Xem các đơn ngày @item.Date.ToString("dd/MM/yyyy")">
                        <time>@item.Date.ToString("dd/MM")</time>
                        <div class="admin-bar-track">
                            <span style="width:@percent%"></span>
                        </div>
                        <strong>@item.Revenue.ToString("N0")</strong>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="admin-empty-state">Chưa có doanh thu trong khoảng ngày này.</div>
        }
    </section>

    <section class="admin-report-card">
        <div class="admin-card-head">
            <div>
                <h5>Thanh toán</h5>
                <span>Theo các đơn được tính doanh thu</span>
            </div>
        </div>
        <div class="admin-payment-split">
            <div>
                <span>Đã thanh toán</span>
                <strong>@Model.PaidOrders</strong>
            </div>
            <div>
                <span>Chưa thanh toán</span>
                <strong>@Model.UnpaidOrders</strong>
            </div>
        </div>

        <div class="admin-status-list">
            @foreach (var item in Model.Statuses)
            {
                <a class="text-decoration-none"
                   asp-action="Details"
                   asp-route-status="@item.Status"
                   asp-route-from="@Model.From"
                   asp-route-to="@Model.To">
                    <span>@StatusText(item.Status)</span>
                    <strong>@item.Count</strong>
                </a>
            }
        </div>
    </section>
</div>

<section class="admin-table-card mt-3">
    <div class="admin-card-head">
        <div>
            <h5>Top sản phẩm bán chạy</h5>
            <span>Xếp theo doanh thu trong khoảng lọc</span>
        </div>
        <a asp-action="TopProducts"
           asp-route-from="@Model.From"
           asp-route-to="@Model.To"
           class="btn btn-outline-primary btn-sm">Xem đầy đủ</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr>
                <th>Sản phẩm</th>
                <th class="text-center">Số lượng</th>
                <th class="text-end">Doanh thu</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.TopProducts.Any())
            {
                foreach (var item in Model.TopProducts)
                {
                    <tr role="button"
                        onclick="window.location.href='@Url.Action("Details", new { productId = item.ProductId, from = Model.From, to = Model.To })'">
                        <td><strong>@item.ProductName</strong></td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end">@item.Revenue.ToString("N0") VND</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center text-muted py-5">Chưa có dữ liệu sản phẩm bán chạy.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
