@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2>📑 Báo cáo doanh thu</h2>

<form method="get" class="row mb-3">
    <div class="col-md-4">
        <label>Từ ngày</label>
        <input type="date" name="from" class="form-control" value="@ViewBag.From" />
    </div>
    <div class="col-md-4">
        <label>Đến ngày</label>
        <input type="date" name="to" class="form-control" value="@ViewBag.To" />
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-primary me-2">Lọc</button>
        <a asp-action="ExportExcel"
           asp-route-from="@ViewBag.From"
           asp-route-to="@ViewBag.To"
           class="btn btn-success">Xuất Excel</a>
    </div>
</form>

<div class="row">
    <div class="col-md-6">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5>Tổng doanh thu</h5>
                <h3>@String.Format("{0:N0} VND", ViewBag.TotalRevenue)</h3>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5>Tổng đơn hàng</h5>
                <h3>@ViewBag.TotalOrders</h3>
            </div>
        </div>
    </div>
</div>

<a asp-action="TopProducts" class="btn btn-dark">
    Xem Top sản phẩm bán chạy
</a>
