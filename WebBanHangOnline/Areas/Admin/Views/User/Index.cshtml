@model List<WebBanHangOnline.Models.ViewModels.UserViewModel>

@{
    ViewData["Title"] = "Quản lý người dùng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h4 class="mb-4">👤 Quản lý người dùng</h4>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Email</th>
            <th>UserName</th>
            <th>Vai trò</th>
            <th>Trạng thái</th>
            <th width="260">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.UserName</td>

                <td>
                    @if (user.IsAdmin)
                    {
                        <span class="badge bg-primary">Admin</span>
                    }
                    else if (user.IsClient)
                    {
                        <span class="badge bg-info">Client</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">User</span>
                    }
                </td>

                <td>
                    @if (user.IsLocked)
                    {
                        <span class="badge bg-danger">Bị khóa</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Hoạt động</span>
                    }
                </td>

                <td class="d-flex gap-2 flex-wrap">
                    @if (!user.IsAdmin)
                    {
                        <!-- KHÓA / MỞ -->
                        <form asp-action="ToggleLock" method="post">
                            <input type="hidden" name="id" value="@user.Id" />
                            <button class="btn btn-sm @(user.IsLocked ? "btn-success" : "btn-warning")">
                                @(user.IsLocked ? "🔓 Mở" : "🔒 Khóa")
                            </button>
                        </form>

                        <!-- CẤP CLIENT -->
                        @if (!user.IsClient)
                        {
                            <form asp-action="GrantClient" method="post">
                                <input type="hidden" name="id" value="@user.Id" />
                                <button class="btn btn-sm btn-info">⭐ Cấp Client</button>
                            </form>
                        }
                        else
                        {
                            <!-- THU HỒI CLIENT -->
                            <form asp-action="RevokeClient" method="post">
                                <input type="hidden" name="id" value="@user.Id" />
                                <button class="btn btn-sm btn-secondary">
                                    <i class="bi bi-arrow-counterclockwise"></i> Thu hồi Client
                                </button>
                            </form>
                        }

                        <!-- XOÁ USER -->
                        <form asp-action="Delete" method="post"
                              onsubmit="return confirm('Bạn chắc chắn muốn xoá user này?')">
                            <input type="hidden" name="id" value="@user.Id" />
                            <button class="btn btn-sm btn-danger">
                                <i class="bi bi-trash3"></i> Xoá
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted fst-italic">Không khả dụng</span>
                    }
                </td>

            </tr>
        }
    </tbody>
</table>
