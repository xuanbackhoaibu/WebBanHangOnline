@model List<WebBanHangOnline.Models.Notification>
@{
    ViewData["Title"] = "Thông báo";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/notifications.css" asp-append-version="true" />
}

<div class="notifications-page">
    <div class="notification-hero">
        <span class="catalog-kicker">News</span>
        <h1>Thông báo</h1>
        <p>Cập nhật ưu đãi, bộ sưu tập mới và thông tin quan trọng từ XuanBac.</p>
    </div>

    <div class="notification-filter">
        <a asp-action="Index" asp-route-type="">Tất cả</a>
        <a asp-action="Index" asp-route-type="flash">Ưu đãi nhanh</a>
        <a asp-action="Index" asp-route-type="promo">Ưu đãi</a>
        <a asp-action="Index" asp-route-type="news">Tin tức</a>
    </div>

    <div class="notification-grid">
        @foreach (var note in Model)
        {
            var isNew = (DateTime.Now - note.CreatedAt).TotalHours < 24;
                <a asp-action="Details" asp-route-id="@note.NotificationId" class="notification-card @note.Type">
                        @if(isNew)
                        {
                            <span class="notification-new">Mới</span>
                        }
                        <div class="notification-card-head">
                            @note.Title
                        </div>
                        <div class="notification-card-body">
                            <p class="notification-copy">@note.Content</p>
                            <small>@note.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                </a>
        }
    </div>
</div>
