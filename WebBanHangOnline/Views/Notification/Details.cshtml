@model WebBanHangOnline.Models.Notification

@{
    ViewData["Title"] = "Chi tiết thông báo";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/notifications.css" asp-append-version="true" />
}

<div class="notifications-page">
    <article class="notification-detail-card">
        <span class="catalog-kicker">News</span>
        <h1>@Model.Title</h1>
        <time>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</time>

        <p>@Model.Content</p>

        <a asp-action="Index" class="notification-back-link">
            <i class="bi bi-arrow-left"></i>
            Quay lại
        </a>
    </article>
</div>
