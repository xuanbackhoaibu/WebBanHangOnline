@model Order

@{
    string StatusClass(string? status) => status switch
    {
        "Completed" => "success",
        "Shipping" => "shipping",
        "Cancelled" => "cancelled",
        _ => "pending"
    };

    string StatusText(string? status) => status switch
    {
        "Pending" => "Chờ thanh toán",
        "Confirmed" => "Đã xác nhận",
        "Shipping" => "Đang giao",
        "Completed" => "Hoàn thành",
        "Cancelled" => "Đã hủy",
        _ => status ?? "Đang xử lý"
    };

    string PaymentStatusText(string? status) => status switch
    {
        "AwaitingConfirmation" => "Chờ xác nhận chuyển khoản",
        "Paid" => "Đã thanh toán",
        "Failed" => "Thanh toán thất bại",
        "Refunded" => "Đã hoàn tiền",
        _ => "Chưa thanh toán"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/order-success.css" asp-append-version="true" />
}

<div class="order-success-page">
    <section class="success-hero">
        <div class="success-mark">
            <i class="bi bi-check2"></i>
        </div>
        <div>
            <span class="catalog-kicker">Order confirmed</span>
            <h1>Đặt hàng thành công</h1>
            <p>Cảm ơn bạn đã chọn XuanBac. Đơn hàng đang được chuẩn bị và có thể theo dõi trong mục đơn hàng.</p>
        </div>
        <div class="success-total">
            <span>Tổng thanh toán</span>
            <strong>@Model.TotalAmount.ToString("N0") VND</strong>
        </div>
    </section>

    <div class="success-layout">
        <main class="success-main">
            <section class="success-card order-overview">
                <div class="success-section-head">
                    <div>
                        <i class="bi bi-receipt"></i>
                        <span>Thông tin đơn hàng</span>
                    </div>
                    <span class="success-status @StatusClass(Model.Status)">@StatusText(Model.Status)</span>
                </div>

                <div class="order-overview-grid">
                    <div>
                        <span>Mã đơn</span>
                        <strong>#@Model.Id</strong>
                    </div>
                    <div>
                        <span>Ngày đặt</span>
                        <strong>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                    <div>
                        <span>Thanh toán</span>
                        <strong>@(Model.PaymentMethod ?? "COD")</strong>
                    </div>
                    <div>
                        <span>Trạng thái thanh toán</span>
                        <strong>@PaymentStatusText(Model.PaymentStatus)</strong>
                    </div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div>
                            <span>Mã giảm giá</span>
                            <strong>@Model.DiscountCode (-@Model.DiscountAmount.ToString("N0") VND)</strong>
                        </div>
                    }
                </div>
            </section>

            <section class="success-card">
                <div class="success-section-head">
                    <div>
                        <i class="bi bi-box-seam"></i>
                        <span>Trạng thái đơn hàng</span>
                    </div>
                </div>

                <div class="success-timeline">
                    <div class="timeline-step active">
                        <span></span>
                        <strong>Đã đặt</strong>
                    </div>
                    <div class="timeline-step @(Model.PaymentStatus == "Paid" || Model.PaymentStatus == "AwaitingConfirmation" ? "active" : "")">
                        <span></span>
                        <strong>@(Model.PaymentStatus == "AwaitingConfirmation" ? "Chờ xác nhận" : "Thanh toán")</strong>
                    </div>
                    <div class="timeline-step @(Model.Status == "Shipping" || Model.Status == "Completed" ? "active" : "")">
                        <span></span>
                        <strong>Giao hàng</strong>
                    </div>
                    <div class="timeline-step @(Model.Status == "Completed" ? "active" : "")">
                        <span></span>
                        <strong>Hoàn thành</strong>
                    </div>
                </div>
            </section>

            <section class="success-card">
                <div class="success-section-head">
                    <div>
                        <i class="bi bi-bag-check"></i>
                        <span>Sản phẩm</span>
                    </div>
                </div>

                <div class="success-products">
                    @foreach (var item in Model.OrderDetails)
                    {
                        <article class="success-product">
                            <img src="@(item.ProductVariant.Product.Thumbnail ?? "/images/no-image.png")"
                                 alt="@item.ProductVariant.Product.Name"
                                 loading="lazy" />
                            <div>
                                <h3>@item.ProductVariant.Product.Name</h3>
                                <div class="success-product-meta">
                                    <span>Size @item.ProductVariant.Size</span>
                                    <span>@item.ProductVariant.Color</span>
                                    <span>x @item.Quantity</span>
                                </div>
                            </div>
                            <strong>@item.Price.ToString("N0") VND</strong>
                        </article>
                    }
                </div>
            </section>
        </main>

        <aside class="success-side">
            <section class="success-card shipping-card">
                <div class="success-section-head">
                    <div>
                        <i class="bi bi-geo-alt"></i>
                        <span>Địa chỉ nhận hàng</span>
                    </div>
                </div>
                <div class="shipping-copy">
                    <strong>@(Model.User?.UserName ?? "Khách hàng")</strong>
                    <span>@Model.PhoneNumber</span>
                    <p>@Model.ShippingAddress</p>
                </div>
            </section>

            <section class="success-card success-actions">
                <a asp-action="MyOrders" class="success-btn secondary">
                    <i class="bi bi-list-check"></i>
                    Xem đơn hàng
                </a>

                @if (Model.Status == "Pending")
                {
                    <a asp-controller="Payment"
                       asp-action="VNPay"
                       asp-route-orderId="@Model.Id"
                       class="success-btn primary">
                        <i class="bi bi-credit-card"></i>
                        Thanh toán VNPay
                    </a>
                }
            </section>
        </aside>
    </div>

    <div class="success-toast">
        <i class="bi bi-check-circle"></i>
        Đơn hàng đã được ghi nhận
    </div>
</div>
