@model List<Order>

@{
    ViewData["Title"] = "Đơn hàng của tôi";

    string StatusClass(string? status) => status switch
    {
        "Completed" => "status-success",
        "Shipping" => "status-warning",
        "Cancelled" => "status-danger",
        _ => "status-gray"
    };

    string ProgressClass(string? status) => status switch
    {
        "Pending" => "progress-25",
        "Confirmed" => "progress-45",
        "Shipping" => "progress-70",
        "Completed" => "progress-100",
        "Cancelled" => "progress-cancel",
        _ => "progress-25"
    };

    string StatusText(string? status) => status switch
    {
        "Pending" => "Chờ xác nhận",
        "Confirmed" => "Đã xác nhận",
        "Shipping" => "Đang giao",
        "Completed" => "Đã giao",
        "Cancelled" => "Đã hủy",
        _ => status ?? "Không rõ"
    };

    string PaymentStatusText(string? status) => status switch
    {
        "AwaitingConfirmation" => "Chờ xác nhận",
        "Paid" => "Đã thanh toán",
        "Failed" => "Thanh toán thất bại",
        "Refunded" => "Đã hoàn tiền",
        _ => "Chưa thanh toán"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/orders.css" asp-append-version="true" />
}

<div class="orders-page">
    <div class="orders-hero">
        <div>
            <span class="catalog-kicker">Orders</span>
            <h1 class="orders-title">Đơn hàng của tôi</h1>
            <p>Theo dõi trạng thái, xem lại sản phẩm đã mua và tiếp tục mua sắm khi cần.</p>
        </div>
        <a asp-area="" asp-controller="Product" asp-action="Index" class="orders-shop-link">
            Mua sắm tiếp
            <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="orders-filter" aria-label="Lọc đơn hàng">
        <button type="button" class="orders-filter-btn active" data-status="all">Tất cả</button>
        <button type="button" class="orders-filter-btn" data-status="Pending">Chờ xác nhận</button>
        <button type="button" class="orders-filter-btn" data-status="Confirmed">Đã xác nhận</button>
        <button type="button" class="orders-filter-btn" data-status="Shipping">Đang giao</button>
        <button type="button" class="orders-filter-btn" data-status="Completed">Đã giao</button>
        <button type="button" class="orders-filter-btn" data-status="Cancelled">Đã hủy</button>
    </div>

    @if (!Model.Any())
    {
        <div class="orders-empty">
            <div class="orders-empty-icon">
                <i class="bi bi-bag"></i>
            </div>
            <h4>Chưa có đơn hàng</h4>
            <p>Hãy mua sắm để tạo đơn đầu tiên.</p>
            <a asp-area="" asp-controller="Product" asp-action="Index" class="orders-btn-main">
                Mua sắm ngay
            </a>
        </div>
    }
    else
    {
        foreach (var order in Model)
        {
            <article class="orders-card" data-status="@order.Status">
                <header class="orders-header">
                    <div>
                        <div class="orders-id">Đơn hàng #@order.Id</div>
                        <div class="orders-date">@order.OrderDate.ToString("dd/MM/yyyy") · @PaymentStatusText(order.PaymentStatus)</div>
                    </div>
                    <div class="orders-status @StatusClass(order.Status)">
                        @StatusText(order.Status)
                    </div>
                </header>

                @if (order.OrderDetails != null)
                {
                    foreach (var item in order.OrderDetails)
                    {
                        var product = item.ProductVariant?.Product;
                        var productName = product?.Name ?? "Sản phẩm";
                        var productImage = !string.IsNullOrEmpty(product?.Thumbnail)
                            ? Url.Content(product.Thumbnail)
                            : "/images/no-image.png";

                        <div class="orders-product-row">
                            <img src="@productImage"
                                 alt="@productName"
                                 class="orders-product-img"
                                 loading="lazy" />

                            <div class="orders-product-info">
                                <div class="orders-product-name">@productName</div>
                                <div class="orders-product-meta">
                                    @if (!string.IsNullOrWhiteSpace(item.ProductVariant?.Color))
                                    {
                                        <span>Màu: @item.ProductVariant.Color</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.ProductVariant?.Size))
                                    {
                                        <span>Size: @item.ProductVariant.Size</span>
                                    }
                                </div>
                                <div class="orders-product-meta">Số lượng: @item.Quantity</div>
                            </div>

                            <div class="orders-product-price">
                                @((item.Price * item.Quantity).ToString("N0")) VND
                            </div>
                        </div>
                    }
                }

                <div class="orders-progress" aria-hidden="true">
                    <div class="orders-progress-bar @ProgressClass(order.Status)"></div>
                </div>

                <footer class="orders-footer">
                    <div class="orders-total">
                        Tổng:
                        <span>@order.TotalAmount.ToString("N0") VND</span>
                        @if (order.DiscountAmount > 0)
                        {
                            <small>Đã giảm @order.DiscountAmount.ToString("N0") VND</small>
                        }
                    </div>

                    <div class="orders-actions">
                        <a asp-area=""
                           asp-controller="Order"
                           asp-action="OrderSuccess"
                           asp-route-id="@order.Id"
                           class="orders-btn-main">
                            Chi tiết
                        </a>

                        @if (order.Status == "Pending")
                        {
                            <form asp-area=""
                                  asp-controller="Order"
                                  asp-action="CancelOrder"
                                  method="post"
                                  class="orders-inline-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@order.Id" />
                                <button type="submit" class="orders-btn-cancel">
                                    Hủy đơn
                                </button>
                            </form>
                        }

                        @if (order.Status == "Completed" || order.Status == "Cancelled")
                        {
                            <a asp-area=""
                               asp-controller="Product"
                               asp-action="Index"
                               class="orders-btn-buy">
                                Mua lại
                            </a>
                        }
                    </div>
                </footer>
            </article>
        }
    }
</div>

@section Scripts {
    <script>
        (() => {
            const buttons = document.querySelectorAll(".orders-filter-btn");
            const orders = document.querySelectorAll(".orders-card");

            buttons.forEach((button) => {
                button.addEventListener("click", () => {
                    buttons.forEach((item) => item.classList.remove("active"));
                    button.classList.add("active");

                    const status = button.dataset.status;
                    orders.forEach((order) => {
                        order.hidden = status !== "all" && order.dataset.status !== status;
                    });
                });
            });
        })();
    </script>
}
