
@model IEnumerable<WebBanHangOnline.Models.Product>
@{
    ViewData["Title"] = "Shop";
    var currentCulture = WebBanHangOnline.Helpers.CatalogTextHelper.IsEnglish ? "en" : "vi";
    var hasActiveFilter = ViewBag.HasActiveFilter == true;
    var hasAdvancedFilter = ViewBag.MinPrice != null || ViewBag.MaxPrice != null || !string.IsNullOrWhiteSpace(ViewBag.Size as string) || !string.IsNullOrWhiteSpace(ViewBag.Color as string);
    var totalItems = ViewBag.TotalItems ?? Model.Count();
    string T(string vi, string en) => WebBanHangOnline.Helpers.CatalogTextHelper.T(vi, en);
    string D(string? value) => WebBanHangOnline.Helpers.CatalogTextHelper.Display(value);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/product.css" asp-append-version="true" />
}

<div class="catalog-page">
    <div class="catalog-hero">
        <div>
            <span class="catalog-kicker">XuanBac shop</span>
            <h1>@T("Sản phẩm thời trang", "Fashion products")</h1>
            <p>@T("Lọc nhanh theo danh mục, giá, size, màu và sắp xếp để tìm đúng mẫu bạn cần.",
                "Filter quickly by category, price, size, color and sorting to find the right item.")</p>
        </div>
        <a asp-controller="Cart" asp-action="Index" class="catalog-cart-link">
            <i class="bi bi-cart3"></i>
            @T("Xem giỏ hàng", "View cart")
        </a>
    </div>

    <form method="get" class="catalog-filter-bar d-none" id="catalogFilterPanel">
        <div class="filter-main-grid">
            <div class="filter-search-field">
                <i class="bi bi-search"></i>
                <input name="keyword"
                       class="form-control"
                       placeholder="@T("Tìm sản phẩm, ví dụ: áo, váy, nam...", "Search products, e.g. shirt, dress, men...")"
                       value="@ViewBag.Keyword" />
            </div>

            <select name="categoryId" class="form-select">
                <option value="">@T("Tất cả danh mục", "All categories")</option>
                @foreach (var c in ViewBag.Categories)
                {
                    <option value="@c.CategoryId" selected="@(ViewBag.CategoryId == c.CategoryId)">
                        @D(c.Name)
                    </option>
                }
            </select>

            <select name="sort" class="form-select">
                <option value="" selected="@(string.IsNullOrEmpty(ViewBag.Sort))">@T("Mới cập nhật", "Recently updated")</option>
                <option value="price_asc" selected="@(ViewBag.Sort == "price_asc")">@T("Giá tăng dần", "Price: low to high")</option>
                <option value="price_desc" selected="@(ViewBag.Sort == "price_desc")">@T("Giá giảm dần", "Price: high to low")</option>
                <option value="newest" selected="@(ViewBag.Sort == "newest")">@T("Mới nhất", "Newest")</option>
            </select>

            <button class="btn btn-filter">
                <i class="bi bi-funnel"></i>
                @T("Áp dụng", "Apply")
            </button>

            <button type="button"
                    class="btn btn-filter-toggle @(hasAdvancedFilter ? "has-values" : "")"
                    id="catalogFilterToggle"
                    aria-controls="catalogAdvancedFilters"
                    aria-expanded="false">
                <i class="bi bi-sliders"></i>
                @T("Nâng cao", "More")
            </button>
        </div>

        <div class="catalog-quick-categories">
            <a asp-action="Index"
               asp-route-keyword="@ViewBag.Keyword"
               asp-route-sort="@ViewBag.Sort"
               class="category-chip @(ViewBag.CategoryId == null ? "is-active" : "")">@T("Tất cả", "All")</a>
            @foreach (var c in ViewBag.Categories)
            {
                <a asp-action="Index"
                   asp-route-categoryId="@c.CategoryId"
                   asp-route-keyword="@ViewBag.Keyword"
                   asp-route-sort="@ViewBag.Sort"
                   class="category-chip @(ViewBag.CategoryId == c.CategoryId ? "is-active" : "")">@D(c.Name)</a>
            }
        </div>

        <div id="catalogAdvancedFilters" class="advanced-filter-grid d-none">
            <div>
                <label class="filter-label">@T("Giá từ", "Price from")</label>
                <input name="minPrice" class="form-control" placeholder="0" value="@ViewBag.MinPrice" />
            </div>
            <div>
                <label class="filter-label">@T("Giá đến", "Price to")</label>
                <input name="maxPrice" class="form-control" placeholder="500000" value="@ViewBag.MaxPrice" />
            </div>
            <div>
                <label class="filter-label">Size</label>
                <select name="size" class="form-select">
                    <option value="">@T("Tất cả", "All")</option>
                    <option selected="@(ViewBag.Size == "S")">S</option>
                    <option selected="@(ViewBag.Size == "M")">M</option>
                    <option selected="@(ViewBag.Size == "L")">L</option>
                    <option selected="@(ViewBag.Size == "XL")">XL</option>
                </select>
            </div>
            <div>
                <label class="filter-label">@T("Màu", "Color")</label>
                <select name="color" class="form-select">
                    <option value="">@T("Tất cả", "All")</option>
                    <option value="Đen" selected="@(ViewBag.Color == "Đen")">@D("Đen")</option>
                    <option value="Trắng" selected="@(ViewBag.Color == "Trắng")">@D("Trắng")</option>
                    <option value="Xanh" selected="@(ViewBag.Color == "Xanh")">@D("Xanh")</option>
                </select>
            </div>
            <div class="advanced-filter-actions">
                <button class="btn btn-filter">
                    <i class="bi bi-check2"></i>
                    @T("Áp dụng", "Apply")
                </button>
                @if (hasActiveFilter)
                {
                    <a asp-action="Index" class="btn btn-clear-filter">
                        <i class="bi bi-x-lg"></i>
                        @T("Xóa lọc", "Clear")
                    </a>
                }
            </div>
        </div>
    </form>

    <!-- PRODUCTS -->
    <div id="catalogProductsColumn">
        <div class="catalog-toolbar">
            <div>
                @if (hasActiveFilter)
                {
                    <strong>@totalItems</strong>
                    <span>@T("sản phẩm phù hợp với bộ lọc", "products match your filters")</span>
                }
                else
                {
                    <span>@T("Tất cả sản phẩm mới nhất", "Latest products")</span>
                }
            </div>
            <button type="button"
                    class="btn btn-filter-toggle @(hasActiveFilter ? "has-values" : "")"
                    id="catalogMainFilterToggle"
                    aria-controls="catalogFilterPanel"
                    aria-expanded="false">
                <i class="bi bi-funnel"></i>
                @T("Lọc", "Filter")
            </button>
        </div>

        <div class="row g-4">
            @foreach (var p in Model)
            {
                <div class="col-6 col-lg-4">
                    <div class="catalog-product-card">
                        <a asp-action="Details" asp-route-id="@p.ProductId" asp-route-slug="@p.Slug" class="catalog-product-image">
                            <img src="@p.Thumbnail" alt="@p.Name" loading="lazy" />
                            <span>@T("Xem nhanh", "Quick view")</span>
                        </a>
                        <div class="catalog-product-body">
                            <small>@D(p.Category?.Name)</small>
                            <h6>@D(p.Name)</h6>
                            <div class="catalog-price">@p.Price.ToString("N0") VND</div>
                            <a asp-action="Details" asp-route-id="@p.ProductId" asp-route-slug="@p.Slug" class="btn btn-detail">
                                @T("Chi tiết", "Details")
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- PAGINATION -->
        <nav>
            <ul class="pagination catalog-pagination">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(ViewBag.Page == i ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-keyword="@ViewBag.Keyword"
                           asp-route-categoryId="@ViewBag.CategoryId"
                           asp-route-minPrice="@ViewBag.MinPrice"
                           asp-route-maxPrice="@ViewBag.MaxPrice"
                           asp-route-size="@ViewBag.Size"
                           asp-route-color="@ViewBag.Color"
                           asp-route-sort="@ViewBag.Sort">@i</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const filterPanel = document.getElementById("catalogFilterPanel");
            const mainToggle = document.getElementById("catalogMainFilterToggle");
            const advancedFilters = document.getElementById("catalogAdvancedFilters");
            const toggle = document.getElementById("catalogFilterToggle");

            if (!filterPanel || !mainToggle || !advancedFilters || !toggle) return;

            const setFilterOpen = (open) => {
                filterPanel.classList.toggle("d-none", !open);
                mainToggle.setAttribute("aria-expanded", open.toString());
                mainToggle.classList.toggle("is-active", open);
            };

            const setAdvancedOpen = (open) => {
                advancedFilters.classList.toggle("d-none", !open);
                toggle.setAttribute("aria-expanded", open.toString());
                toggle.classList.toggle("is-active", open);
            };

            mainToggle.addEventListener("click", () => {
                setFilterOpen(filterPanel.classList.contains("d-none"));
            });

            toggle.addEventListener("click", () => {
                setAdvancedOpen(advancedFilters.classList.contains("d-none"));
            });
        })();
    </script>
}
