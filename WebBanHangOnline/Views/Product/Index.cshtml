
@model IEnumerable<WebBanHangOnline.Models.Product>
@{
    ViewData["Title"] = "Shop";
}

<div class="catalog-page">
    <div class="catalog-hero">
        <div>
            <span class="catalog-kicker">XuanBac shop</span>
            <h1>Sản phẩm thời trang</h1>
            <p>Lọc nhanh theo danh mục, giá, size, màu và sắp xếp để tìm đúng mẫu bạn cần.</p>
        </div>
        <a asp-controller="Cart" asp-action="Index" class="catalog-cart-link">
            <i class="bi bi-cart3"></i>
            Xem giỏ hàng
        </a>
    </div>

    <div class="row g-4">
    <!-- FILTER -->
    <div class="col-lg-3">
        <form method="get" class="filter-panel">
            <div class="filter-title">
                <i class="bi bi-sliders"></i>
                Bộ lọc
            </div>

            <label class="filter-label">Từ khóa</label>
            <input name="keyword" class="form-control mb-3" placeholder="Tìm sản phẩm..." value="@ViewBag.Keyword" />

            <label class="filter-label">Danh mục</label>
            <select name="categoryId" class="form-select mb-3">
                <option value="">Tất cả</option>
                @foreach (var c in ViewBag.Categories)
                {
                    <option value="@c.CategoryId">@c.Name</option>
                }
            </select>

            <label class="filter-label">Khoảng giá</label>
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <input name="minPrice" class="form-control" placeholder="Từ" value="@ViewBag.MinPrice" />
                </div>
                <div class="col-6">
                    <input name="maxPrice" class="form-control" placeholder="Đến" value="@ViewBag.MaxPrice" />
                </div>
            </div>

            <label class="filter-label">Size</label>
            <select name="size" class="form-select mb-3">
                <option value="">Tất cả</option>
                <option>S</option><option>M</option><option>L</option><option>XL</option>
            </select>

            <label class="filter-label">Màu</label>
            <select name="color" class="form-select mb-3">
                <option value="">Tất cả</option>
                <option>Đen</option><option>Trắng</option><option>Xanh</option>
            </select>

            <label class="filter-label">Sắp xếp</label>
            <select name="sort" class="form-select mb-4">
                <option value="">Mới cập nhật</option>
                <option value="price_asc">Giá tăng dần</option>
                <option value="price_desc">Giá giảm dần</option>
                <option value="newest">Mới nhất</option>
            </select>

            <button class="btn btn-filter w-100">
                <i class="bi bi-funnel"></i>
                Áp dụng bộ lọc
            </button>
        </form>
    </div>

    <!-- PRODUCTS -->
    <div class="col-lg-9">
        <div class="catalog-toolbar">
            <div>
                <strong>@Model.Count()</strong>
                <span>sản phẩm đang hiển thị</span>
            </div>
            <span class="toolbar-note">Docker demo · Seed data · API ready</span>
        </div>

        <div class="row g-4">
            @foreach (var p in Model)
            {
                <div class="col-6 col-lg-4">
                    <div class="catalog-product-card">
                        <a asp-action="Details" asp-route-id="@p.ProductId" asp-route-slug="@p.Slug" class="catalog-product-image">
                            <img src="@p.Thumbnail" alt="@p.Name" loading="lazy" />
                            <span>Xem nhanh</span>
                        </a>
                        <div class="catalog-product-body">
                            <small>@p.Category?.Name</small>
                            <h6>@p.Name</h6>
                            <div class="catalog-price">@p.Price.ToString("N0") đ</div>
                            <a asp-action="Details" asp-route-id="@p.ProductId" asp-route-slug="@p.Slug" class="btn btn-detail">
                                Chi tiết
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- PAGINATION -->
        <nav>
            <ul class="pagination catalog-pagination">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(ViewBag.Page == i ? "active" : "")">
                        <a class="page-link" href="?page=@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
    </div>
</div>
