@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using WebBanHangOnline.Data
@using WebBanHangOnline.Models
@inject ApplicationDbContext DetailDbContext
@inject UserManager<ApplicationUser> DetailUserManager
@model WebBanHangOnline.Models.Product

@{
    ViewData["Title"] = WebBanHangOnline.Helpers.CatalogTextHelper.Display(Model.Name);
    string T(string vi, string en) => WebBanHangOnline.Helpers.CatalogTextHelper.T(vi, en);
    string D(string? value) => WebBanHangOnline.Helpers.CatalogTextHelper.Display(value);

    var averageRating = Model.Reviews != null && Model.Reviews.Any()
        ? Model.Reviews.Average(r => r.Rating)
        : 0;
    var reviewCount = Model.Reviews?.Count ?? 0;
    var isFlashSale = Model.FlashSalePrice.HasValue
        && Model.FlashSaleEnd.HasValue
        && Model.FlashSaleEnd > DateTime.Now;
    var mainImage = !string.IsNullOrWhiteSpace(Model.Thumbnail)
        ? Model.Thumbnail
        : Model.Images?.FirstOrDefault()?.ImageUrl ?? "/images/no-image.png";
    var galleryImages = new[] { mainImage }
        .Concat(Model.Images?.Select(image => image.ImageUrl) ?? Enumerable.Empty<string>())
        .Where(imageUrl => !string.IsNullOrWhiteSpace(imageUrl))
        .Distinct()
        .ToList();
    var variants = Model.Variants ?? new List<WebBanHangOnline.Models.ProductVariant>();
    var totalStock = variants.Sum(variant => variant.Stock);
    var relatedProducts = ViewBag.Related as IEnumerable<WebBanHangOnline.Models.Product>
        ?? Enumerable.Empty<WebBanHangOnline.Models.Product>();
    var canReview = ViewBag.CanReview == true;
    var userReview = ViewBag.UserReview as WebBanHangOnline.Models.Review;
    var reviewGateMessage = ViewBag.ReviewGateMessage as string;
    var isWishlisted = ViewBag.IsWishlisted == true;
    var cartCount = 0;
    var wishlistCount = 0;
    if (User.Identity?.IsAuthenticated == true)
    {
        var detailUserId = DetailUserManager.GetUserId(User);
        cartCount = await DetailDbContext.CartItems
            .Where(item => item.UserId == detailUserId)
            .SumAsync(item => (int?)item.Quantity) ?? 0;
        wishlistCount = await DetailDbContext.WishlistItems
            .Where(item => item.UserId == detailUserId)
            .CountAsync();
    }
    var displayPrice = Model.FinalPrice;
    var freeShipGoal = 999000m;
    var freeShipRemaining = Math.Max(0, freeShipGoal - displayPrice);
    var freeShipProgress = Math.Min(100, (int)Math.Round(displayPrice / freeShipGoal * 100));
    var deliveryDate = DateTime.Now.Hour < 16
        ? DateTime.Now.AddDays(3)
        : DateTime.Now.AddDays(4);
    var viewerCount = 8 + (Model.ProductId % 11);
    var lowestStockVariant = variants
        .Where(variant => variant.Stock > 0)
        .OrderBy(variant => variant.Stock)
        .FirstOrDefault();
    var ratingRows = Enumerable.Range(1, 5)
        .Reverse()
        .Select(star =>
        {
            var count = Model.Reviews?.Count(review => review.Rating == star) ?? 0;
            var percent = reviewCount > 0 ? (int)Math.Round(count * 100.0 / reviewCount) : 0;
            return new { Star = star, Count = count, Percent = percent };
        })
        .ToList();
    string SizeHint(string? size) => (size ?? string.Empty).ToUpperInvariant() switch
    {
        "S" => T("Gợi ý 45-52kg, cao 1m50-1m60", "Suggested for 45-52kg, 1.50m-1.60m"),
        "M" => T("Gợi ý 53-60kg, cao 1m60-1m68", "Suggested for 53-60kg, 1.60m-1.68m"),
        "L" => T("Gợi ý 61-68kg, cao 1m68-1m75", "Suggested for 61-68kg, 1.68m-1.75m"),
        "XL" => T("Gợi ý 69-78kg, cao 1m72-1m82", "Suggested for 69-78kg, 1.72m-1.82m"),
        _ => T("Xem bảng size hoặc nhắn shop để được tư vấn", "Check size guide or message us for advice")
    };

    ViewData["SeoTitle"] = D(Model.Name);
    ViewData["SeoDescription"] = !string.IsNullOrWhiteSpace(Model.Description)
        ? D(Model.Description)
        : T("Sản phẩm thời trang XuanBac với chất liệu chọn lọc và phom dáng dễ mặc.",
            "XuanBac fashion item with selected material and an easy-to-style fit.");
    ViewData["OgType"] = "product";
    ViewData["OgImage"] = mainImage;
    ViewData["OgPrice"] = Model.FinalPrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/product-detail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/muva.css" asp-append-version="true" />
}

<div class="muva-page muva-detail-page product-detail-page">
    <header class="muva-nav muva-shop-nav">
        <div class="muva-wrap">
            <a class="muva-logo" asp-controller="Home" asp-action="About">XuanBac<em>.</em></a>
            <a class="muva-nav-back" asp-controller="Product" asp-action="Index"><i class="bi bi-arrow-left"></i> Cửa hàng</a>
            <nav aria-label="Product navigation">
                <a asp-controller="Product" asp-action="Index">@T("Sản phẩm", "Products")</a>
                <a asp-controller="Home" asp-action="About">@T("Giới thiệu", "About")</a>
            </nav>
            <div class="muva-nav-actions">
                <a class="muva-icon-link" asp-controller="Wishlist" asp-action="Index" aria-label="@T("Yêu thích", "Wishlist")" title="@T($"Yêu thích: {wishlistCount} sản phẩm", $"Wishlist: {wishlistCount} items")">
                    <i class="bi bi-heart"></i>
                    <span class="cart-badge wishlist-badge">@wishlistCount</span>
                </a>
                <a class="muva-icon-link" asp-controller="Cart" asp-action="Index" aria-label="@T("Giỏ hàng", "Cart")" title="@T($"Giỏ hàng: {cartCount} sản phẩm", $"Cart: {cartCount} items")">
                    <i class="bi bi-bag"></i>
                    <span class="cart-badge">@cartCount</span>
                </a>
            </div>
        </div>
    </header>

    <div class="detail-shell">
        <div class="detail-gallery">
            <div class="detail-main-image">
                @if (isFlashSale)
                {
                    <span class="detail-sale-badge">@T("Ưu đãi", "Offer")</span>
                }
                <form asp-controller="Wishlist"
                      asp-action="Toggle"
                      method="post"
                      class="detail-wishlist-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <button type="submit"
                            class="detail-wishlist-btn @(isWishlisted ? "is-saved" : "")"
                            aria-label="@(isWishlisted ? T("Bỏ khỏi yêu thích", "Remove from wishlist") : T("Thêm vào yêu thích", "Add to wishlist"))"
                            title="@(isWishlisted ? T("Bỏ khỏi yêu thích", "Remove from wishlist") : T("Thêm vào yêu thích", "Add to wishlist"))">
                        <i class="bi @(isWishlisted ? "bi-heart-fill" : "bi-heart")"></i>
                    </button>
                </form>
                <button type="button" class="detail-lightbox-trigger" id="openLightbox" aria-label="@T("Xem ảnh toàn màn hình", "View fullscreen image")">
                    <i class="bi bi-arrows-fullscreen"></i>
                </button>
                <span class="zoom-hint"><i class="bi bi-search"></i> @T("Rê chuột để soi chất liệu", "Hover to inspect fabric")</span>
                <img id="mainImage" src="@mainImage" alt="@D(Model.Name)" />
                <div class="zoom-lens" id="zoomLens" aria-hidden="true"></div>
            </div>

            <div class="detail-thumbs">
                @foreach (var imageUrl in galleryImages)
                {
                    <button type="button" class="thumb-button @(imageUrl == mainImage ? "active-thumb" : "")">
                        <img src="@imageUrl" class="thumbnail-img" alt="@D(Model.Name)" />
                    </button>
                }
            </div>
        </div>

            <div class="detail-summary">
                <div class="detail-category">@D(Model.Category?.Name)</div>
                <h1>@D(Model.Name)</h1>

                <div class="detail-rating-row">
                <div class="detail-stars">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="bi @(i <= averageRating ? "bi-star-fill" : "bi-star")"></i>
                    }
                </div>
                <span>@averageRating.ToString("0.0")</span>
                <span class="detail-dot"></span>
                <span>@reviewCount @T("đánh giá", "reviews")</span>
                <span class="detail-dot"></span>
                <span>@totalStock @T("sản phẩm có sẵn", "items available")</span>
            </div>

            @if (isFlashSale)
            {
                <div class="flash-sale">
                    <i class="bi bi-clock"></i>
                    @T("Ưu đãi còn:", "Offer ends in:")
                    <span id="countdown"></span>
                </div>
            }

            <div class="detail-price-box">
                @if (isFlashSale)
                {
                    <span class="price-old">@Model.Price.ToString("N0") VND</span>
                    <strong>@Model.FlashSalePrice?.ToString("N0") VND</strong>
                }
                else
                {
                    <strong>@Model.Price.ToString("N0") VND</strong>
                }
            </div>

            <form id="cartForm" asp-controller="Cart" asp-action="Add" method="post" class="detail-buy-panel">
                @Html.AntiForgeryToken()
                <input type="hidden" name="variantId" id="variantId" />

                <div class="option-block">
                    <div class="option-heading">
                        <label>Size</label>
                        <span>@T("Chọn size phù hợp với bạn", "Choose your fit")</span>
                    </div>
                    <div class="option-list">
                        @foreach (var size in variants.Select(variant => variant.Size).Where(size => !string.IsNullOrWhiteSpace(size)).Distinct())
                        {
                            var sizeStock = variants.Where(variant => variant.Size == size).Sum(variant => variant.Stock);
                            <button type="button"
                                    class="variant-btn size-btn @(sizeStock <= 0 ? "is-sold-out" : "")"
                                    data-size="@size"
                                    data-hint="@SizeHint(size)">
                                @size
                                <span>@SizeHint(size)</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="option-block">
                    <div class="option-heading">
                        <label>@T("Màu sắc", "Color")</label>
                        <span>@T("Màu sẽ hiện theo size đã chọn", "Colors depend on selected size")</span>
                    </div>
                    <div id="colorContainer" class="option-list muted-option">
                        @T("Chọn size trước để xem màu còn hàng", "Choose a size first to see available colors")
                    </div>
                </div>

                <div class="stock-panel">
                    <div>
                        <span>@T("Tồn kho", "Stock")</span>
                        <strong id="stockText">@T("Vui lòng chọn phân loại", "Please choose an option")</strong>
                    </div>
                    <i class="bi bi-box-seam"></i>
                </div>

                <div id="urgencyPanel" class="urgency-panel">
                    <i class="bi bi-fire"></i>
                    <span id="urgencyText"></span>
                </div>

                <div id="notifyPanel" class="notify-panel">
                    <div>
                        <strong>@T("Phân loại này tạm hết hàng", "This variant is temporarily out of stock")</strong>
                        <span>@T("Để lại email, shop sẽ báo khi hàng về.", "Leave your email and we will notify you when it is back.")</span>
                    </div>
                    <div class="notify-row">
                        <input type="email" id="stockNotifyEmail" placeholder="email@example.com" />
                        <button type="button" id="stockNotifyBtn">@T("Báo tôi", "Notify me")</button>
                    </div>
                </div>

                <div id="variantError" class="variant-error">
                    <i class="bi bi-exclamation-circle"></i>
                    @T("Vui lòng chọn đầy đủ Size và Màu trước khi tiếp tục.", "Please choose both size and color before continuing.")
                </div>

                <div class="quantity-row">
                    <label>@T("Số lượng", "Quantity")</label>
                    <div class="quantity-stepper">
                        <button type="button" id="decreaseQty" aria-label="@T("Giảm số lượng", "Decrease quantity")">-</button>
                        <input type="number" name="quantity" id="quantityInput" value="1" min="1" />
                        <button type="button" id="increaseQty" aria-label="@T("Tăng số lượng", "Increase quantity")">+</button>
                    </div>
                </div>

                <div class="detail-actions">
                    <button type="submit" id="addToCartBtn" class="detail-action detail-cart-btn btn-disabled">
                        <i class="bi bi-cart-plus"></i>
                        @T("Thêm vào giỏ", "Add to cart")
                    </button>
                    <button type="button" id="buyNowBtn" class="detail-action detail-buy-btn btn-disabled" onclick="buyNow()">
                        <i class="bi bi-bag-check"></i>
                        @T("Mua ngay", "Buy now")
                    </button>
                </div>

                <div class="commerce-insights">
                    <div class="freeship-card">
                        <i class="bi bi-truck"></i>
                        <div>
                            <span>@T("Vận chuyển", "Shipping")</span>
                            @if (freeShipRemaining <= 0)
                            {
                                <strong>@T("Đã đủ freeship", "Free shipping applied")</strong>
                            }
                            else
                            {
                                <strong>@T($"+{freeShipRemaining:N0} VND để freeship", $"+{freeShipRemaining:N0} VND for freeship")</strong>
                            }
                        </div>
                    </div>
                    <div class="delivery-card">
                        <i class="bi bi-calendar2-check"></i>
                        <div>
                            <span>@T("Nhận hàng", "Delivery")</span>
                            <strong>@deliveryDate.ToString("dd/MM")</strong>
                        </div>
                    </div>
                    <div class="viewer-card">
                        <i class="bi bi-eye"></i>
                        <div>
                            <span>@T("Đang xem", "Viewing")</span>
                            <strong>@viewerCount @T("người", "people")</strong>
                        </div>
                    </div>
                </div>
            </form>

            <div class="detail-policy-grid">
                <div class="policy-card">
                    <i class="bi bi-truck"></i>
                    <div>
                        <strong>@T("Giao hàng nhanh", "Fast delivery")</strong>
                        <span>@T("Nội thành 1-2 ngày, toàn quốc 3-5 ngày.", "1-2 days in city, 3-5 days nationwide.")</span>
                    </div>
                </div>
                <div class="policy-card">
                    <i class="bi bi-arrow-repeat"></i>
                    <div>
                        <strong>@T("Đổi size 7 ngày", "7-day size exchange")</strong>
                        <span>@T("Hỗ trợ đổi khi sản phẩm còn tem mác.", "Supported when tags are intact.")</span>
                    </div>
                </div>
                <div class="policy-card">
                    <i class="bi bi-shield-check"></i>
                    <div>
                        <strong>@T("Kiểm tra khi nhận", "Check on delivery")</strong>
                        <span>@T("Được kiểm tra sản phẩm trước khi thanh toán COD.", "Inspect items before COD payment.")</span>
                    </div>
                </div>
                <div class="policy-card">
                    <i class="bi bi-credit-card"></i>
                    <div>
                        <strong>@T("Thanh toán linh hoạt", "Flexible payment")</strong>
                        <span>@T("Hỗ trợ COD, VNPay, MoMo và VietQR.", "COD, VNPay, MoMo and VietQR supported.")</span>
                    </div>
                </div>
            </div>

            <div class="product-accordions">
                <details open>
                    <summary><span>@T("Chất liệu & form dáng", "Material & fit")</span><i class="bi bi-chevron-down"></i></summary>
                    <p>@T("Chất liệu thoáng, dễ phối và giữ phom tốt. Nếu bạn ở giữa hai size, hãy chọn size lớn hơn để mặc thoải mái.",
                        "Breathable, easy to style and holds its fit. If you are between sizes, choose the larger size for comfort.")</p>
                </details>
                <details>
                    <summary><span>@T("Hướng dẫn bảo quản", "Care guide")</span><i class="bi bi-chevron-down"></i></summary>
                    <p>@T("Giặt mặt trái với nước lạnh, tránh sấy nhiệt cao và phơi nơi thoáng mát để giữ màu lâu hơn.",
                        "Wash inside out with cold water, avoid high heat drying and air dry to preserve color.")</p>
                </details>
                <details>
                    <summary><span>@T("Đổi trả & bảo hành", "Returns & support")</span><i class="bi bi-chevron-down"></i></summary>
                    <p>@T("Hỗ trợ đổi size trong 7 ngày khi sản phẩm còn nguyên tem mác và chưa qua sử dụng.",
                        "Size exchange is supported within 7 days when tags are intact and the item is unused.")</p>
                </details>
            </div>
        </div>
    </div>

    <div class="sticky-pdp-bar" id="stickyPdpBar">
        <img src="@mainImage" alt="@D(Model.Name)" />
        <div>
            <strong>@D(Model.Name)</strong>
            <span>@displayPrice.ToString("N0") VND</span>
        </div>
        <button type="button" id="stickyBuyNow" class="btn-disabled">
            <i class="bi bi-bag-check"></i>
            @T("Mua ngay", "Buy now")
        </button>
    </div>

    <div class="detail-lightbox" id="detailLightbox" aria-hidden="true">
        <button type="button" class="lightbox-close" id="closeLightbox" aria-label="@T("Đóng", "Close")">
            <i class="bi bi-x-lg"></i>
        </button>
        <button type="button" class="lightbox-nav lightbox-prev" id="lightboxPrev" aria-label="@T("Ảnh trước", "Previous image")">
            <i class="bi bi-chevron-left"></i>
        </button>
        <img id="lightboxImage" src="@mainImage" alt="@D(Model.Name)" />
        <button type="button" class="lightbox-nav lightbox-next" id="lightboxNext" aria-label="@T("Ảnh tiếp theo", "Next image")">
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>

    <div class="detail-info-grid">
        <section class="detail-card">
            <div class="detail-section-title">
                <span>@T("Mô tả sản phẩm", "Description")</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="product-description">@D(Model.Description)</p>
            }
            else
            {
                <p class="product-description text-muted">@T("Sản phẩm chưa có mô tả.", "This product does not have a description yet.")</p>
            }
        </section>
    </div>

    @if (relatedProducts.Any())
    {
        <section class="detail-card outfit-panel">
            <div class="detail-section-title">
                <span>@T("Gợi ý phối cùng", "Complete the look")</span>
                <small>@T("Chọn thêm để outfit hài hòa hơn", "Add pieces for a balanced outfit")</small>
            </div>
            <div class="outfit-grid">
                @foreach (var product in relatedProducts.Take(3))
                {
                    <a asp-controller="Product"
                       asp-action="Details"
                       asp-route-id="@product.ProductId"
                       asp-route-slug="@product.Slug"
                       class="outfit-card">
                        <img src="@(product.Thumbnail ?? "/images/no-image.png")" alt="@D(product.Name)" />
                        <div>
                            <strong>@D(product.Name)</strong>
                            <span>@product.FinalPrice.ToString("N0") VND</span>
                        </div>
                    </a>
                }
            </div>
        </section>
    }

    <section class="detail-card review-panel">
        <div class="detail-section-title">
            <span>@T("Đánh giá sản phẩm", "Product reviews")</span>
            <small>@reviewCount @T("đánh giá", "reviews")</small>
        </div>

        @if (TempData["ReviewSuccess"] != null)
        {
            <div class="review-alert success">
                <i class="bi bi-check-circle"></i>
                @TempData["ReviewSuccess"]
            </div>
        }
        @if (TempData["ReviewError"] != null)
        {
            <div class="review-alert error">
                <i class="bi bi-exclamation-circle"></i>
                @TempData["ReviewError"]
            </div>
        }

        @if (canReview)
        {
            <form asp-action="AddReview" method="post" class="review-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.ProductId" />

                <div class="review-form-head">
                    <div>
                        <strong>@T("Viết đánh giá của bạn", "Write your review")</strong>
                        <span>@T("Chọn số sao và chia sẻ cảm nhận thật về sản phẩm đã mua.", "Choose a rating and share your real experience.")</span>
                    </div>
                    <div class="star-input" aria-label="@T("Chọn số sao", "Choose rating")">
                        @for (int star = 5; star >= 1; star--)
                        {
                            <input type="radio" id="rating-add-@star" name="rating" value="@star" @(star == 5 ? "checked" : "") />
                            <label for="rating-add-@star" title="@star sao"><i class="bi bi-star-fill"></i></label>
                        }
                    </div>
                </div>

                <div class="review-compose">
                    <textarea name="comment"
                              maxlength="500"
                              required
                              placeholder="@T("Ví dụ: chất vải, form dáng, màu sắc, giao hàng...", "Example: fabric, fit, color, delivery...")"></textarea>
                    <button type="submit">
                        <i class="bi bi-send"></i>
                        @T("Gửi", "Send")
                    </button>
                </div>
            </form>
        }
        else if (userReview != null)
        {
            <form asp-action="EditReview" method="post" class="review-form user-review-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="reviewId" value="@userReview.ReviewId" />

                <div class="review-form-head">
                    <div>
                        <strong>@T("Đánh giá của bạn", "Your review")</strong>
                        <span>@T("Bạn có thể sửa hoặc xoá đánh giá đã gửi cho sản phẩm này.", "You can edit or delete your review for this product.")</span>
                    </div>
                    <div class="star-input" aria-label="@T("Chọn số sao", "Choose rating")">
                        @for (int star = 5; star >= 1; star--)
                        {
                            <input type="radio" id="rating-edit-@star" name="rating" value="@star" @(star == userReview.Rating ? "checked" : "") />
                            <label for="rating-edit-@star" title="@star sao"><i class="bi bi-star-fill"></i></label>
                        }
                    </div>
                </div>

                <div class="review-compose">
                    <textarea name="comment" maxlength="500" required>@userReview.Comment</textarea>
                    <button type="submit">
                        <i class="bi bi-pencil-square"></i>
                        @T("Lưu", "Save")
                    </button>
                </div>
            </form>

            <form asp-action="DeleteReview" method="post" class="review-delete-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="reviewId" value="@userReview.ReviewId" />
                <button type="submit" onclick="return confirm('@T("Bạn muốn xoá đánh giá này?", "Delete this review?")')">
                    <i class="bi bi-trash3"></i>
                    @T("Xoá đánh giá", "Delete review")
                </button>
            </form>
        }
        else
        {
            <div class="review-gate">
                <i class="bi bi-patch-check"></i>
                <div>
                    <strong>@T("Đánh giá từ khách đã mua", "Verified purchase reviews")</strong>
                    <span>@reviewGateMessage</span>
                </div>
            </div>
        }

        <div class="review-summary">
            <div class="review-score">
                <div class="review-score-value">
                    <strong>@averageRating.ToString("0.0")</strong>
                    <span>/5</span>
                </div>
                <div class="detail-stars">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="bi @(i <= averageRating ? "bi-star-fill" : "bi-star")"></i>
                    }
                </div>
                <small>@reviewCount @T("đánh giá", "reviews")</small>
            </div>

            <div class="review-histogram" aria-label="@T("Phân bố đánh giá", "Rating distribution")">
                @foreach (var row in ratingRows)
                {
                    <div class="histogram-row">
                        <span>@row.Star <i class="bi bi-star-fill"></i></span>
                        <div><b style="width: @row.Percent%"></b></div>
                        <em>@row.Count</em>
                    </div>
                }
            </div>

            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                <div class="review-list">
                    @foreach (var review in Model.Reviews.OrderByDescending(item => item.UpdatedAt ?? item.CreatedAt))
                    {
                        <div class="review-item">
                            <div class="review-meta">
                                <div class="fw-bold">
                                    @review.UserName
                                    @if (!string.IsNullOrWhiteSpace(review.UserId))
                                    {
                                        <span class="verified-review">@T("Đã mua", "Verified")</span>
                                    }
                                </div>
                                <time>@((review.UpdatedAt ?? review.CreatedAt).ToString("dd/MM/yyyy"))</time>
                            </div>
                            <div class="review-star">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= review.Rating ? "bi-star-fill" : "bi-star")"></i>
                                }
                            </div>
                            <p>@review.Comment</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="review-empty">
                    <i class="bi bi-chat-square-heart"></i>
                    <strong>@T("Chưa có đánh giá nào", "No reviews yet")</strong>
                    <span>@T("Hãy là người đầu tiên đánh giá sản phẩm sau khi mua hàng.", "Be the first to review this product after purchase.")</span>
                </div>
            }
        </div>
    </section>

    @if (relatedProducts.Any())
    {
        <section class="related-products">
            <div class="detail-section-title">
                <span>@T("Sản phẩm liên quan", "Related products")</span>
                <a asp-action="Index" asp-route-categoryId="@Model.CategoryId">@T("Xem thêm", "View more")</a>
            </div>

            <div class="related-grid">
                @foreach (var product in relatedProducts)
                {
                    <a asp-controller="Product"
                       asp-action="Details"
                       asp-route-id="@product.ProductId"
                       asp-route-slug="@product.Slug"
                       class="related-card">
                        <img src="@(product.Thumbnail ?? "/images/no-image.png")" alt="@D(product.Name)" />
                        <div>
                            <strong>@D(product.Name)</strong>
                            <span>@product.FinalPrice.ToString("N0") VND</span>
                        </div>
                    </a>
                }
            </div>
        </section>
    }
</div>

@section Scripts {
<script src="~/js/muva.js" asp-append-version="true"></script>
<script>
    const variants = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        variants.Select(v => new { v.Id, v.Size, v.Color, ColorText = WebBanHangOnline.Helpers.CatalogTextHelper.Display(v.Color), v.Stock })
    ));
    const galleryImages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(galleryImages));
    const text = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
    {
        inStock = T("sản phẩm có sẵn", "items available"),
        outOfStock = T("Số lượng vượt quá tồn kho!", "Quantity exceeds available stock!"),
        ended = T("Đã kết thúc", "Ended"),
        selectSizeFirst = T("Chọn size trước để xem màu còn hàng", "Choose a size first to see available colors"),
        lowStock = T("Chỉ còn {0} chiếc cuối cùng cho phân loại này.", "Only {0} pieces left for this option."),
        outOfStockVariant = T("Phân loại này đang hết hàng.", "This option is out of stock."),
        notifySuccess = T("Đã ghi nhận email, shop sẽ báo khi hàng về.", "Email saved. We will notify you when it is back."),
        invalidEmail = T("Vui lòng nhập email hợp lệ.", "Please enter a valid email.")
    }));

    let selectedSize = null;
    let selectedColor = null;
    let selectedStock = 0;
    let currentGalleryIndex = 0;

    const colorMap = {
        "den": "#151515",
        "black": "#151515",
        "trang": "#f7f4ef",
        "white": "#f7f4ef",
        "xam": "#8b8f98",
        "gray": "#8b8f98",
        "grey": "#8b8f98",
        "xanh": "#2f6f9f",
        "blue": "#2f6f9f",
        "navy": "#17233f",
        "do": "#b63835",
        "red": "#b63835",
        "hong": "#e7a1ad",
        "pink": "#e7a1ad",
        "be": "#c6aa84",
        "nau": "#7a5338",
        "brown": "#7a5338",
        "tim": "#7f5fb2",
        "purple": "#7f5fb2"
    };

    function normalizeColorName(value) {
        return (value || "")
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .toLowerCase()
            .trim();
    }

    function getSwatchColor(value) {
        const normalized = normalizeColorName(value);
        return colorMap[normalized] || "#d7cdc4";
    }

    function setMainImage(src) {
        const mainImg = document.getElementById("mainImage");
        mainImg.style.opacity = 0;
        setTimeout(() => {
            mainImg.src = src;
            mainImg.style.opacity = 1;
        }, 150);
    }

    document.querySelectorAll(".thumb-button").forEach(button => {
        button.addEventListener("click", function () {
            const image = this.querySelector("img");
            currentGalleryIndex = galleryImages.findIndex(item => image.src.endsWith(item));
            if (currentGalleryIndex < 0) currentGalleryIndex = 0;
            setMainImage(image.src);
            document.querySelectorAll(".thumb-button").forEach(thumb => thumb.classList.remove("active-thumb"));
            this.classList.add("active-thumb");
        });
    });

    document.querySelectorAll(".size-btn").forEach(btn => {
        btn.addEventListener("click", function () {
            document.querySelectorAll(".size-btn").forEach(button => button.classList.remove("active"));
            this.classList.add("active");
            selectedSize = this.dataset.size;
            selectedColor = null;
            selectedStock = 0;
            document.getElementById("variantId").value = "";
            document.getElementById("stockText").innerText = text.selectSizeFirst;
            renderColors();
            renderUrgency();
            updateButtons();
        });
    });

    function renderColors() {
        const container = document.getElementById("colorContainer");
        container.innerHTML = "";
        container.classList.remove("muted-option");

        const colors = [...new Set(
            variants.filter(variant => variant.Size === selectedSize).map(variant => variant.Color)
        )];

        if (!colors.length) {
            container.classList.add("muted-option");
            container.innerText = text.selectSizeFirst;
            return;
        }

        colors.forEach(color => {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "variant-btn color-btn";
            btn.dataset.color = color;
            const variant = variants.find(item => item.Size === selectedSize && item.Color === color);
            if (variant && variant.Stock <= 0) {
                btn.classList.add("is-sold-out");
            }
            const swatch = document.createElement("i");
            swatch.style.background = getSwatchColor(variant?.ColorText || color);
            const label = document.createElement("span");
            label.innerText = variant?.ColorText || color;
            btn.append(swatch, label);
            btn.onclick = function () {
                document.querySelectorAll("#colorContainer .variant-btn").forEach(button => button.classList.remove("active"));
                this.classList.add("active");
                selectedColor = color;
                setVariant();
            };
            container.appendChild(btn);
        });
    }

    function setVariant() {
        const variant = variants.find(item => item.Size === selectedSize && item.Color === selectedColor);
        if (!variant) return;

        selectedStock = variant.Stock;
        document.getElementById("variantId").value = variant.Id;
        document.getElementById("stockText").innerText = variant.Stock > 0
            ? variant.Stock + " " + text.inStock
            : text.outOfStockVariant;
        document.getElementById("quantityInput").max = variant.Stock;
        renderUrgency();
        updateButtons();
    }

    function updateButtons() {
        const addBtn = document.getElementById("addToCartBtn");
        const buyBtn = document.getElementById("buyNowBtn");
        const stickyBuyNow = document.getElementById("stickyBuyNow");
        const ready = selectedSize && selectedColor && selectedStock > 0;

        addBtn.classList.toggle("btn-disabled", !ready);
        buyBtn.classList.toggle("btn-disabled", !ready);
        stickyBuyNow?.classList.toggle("btn-disabled", !ready);
        document.getElementById("notifyPanel")?.classList.toggle("is-visible", selectedSize && selectedColor && selectedStock <= 0);
    }

    function renderUrgency() {
        const panel = document.getElementById("urgencyPanel");
        const message = document.getElementById("urgencyText");
        if (!panel || !message) return;

        if (selectedStock > 0 && selectedStock <= 5) {
            message.innerText = text.lowStock.replace("{0}", selectedStock);
            panel.classList.add("is-visible");
            return;
        }

        panel.classList.remove("is-visible");
    }

    document.getElementById("decreaseQty").addEventListener("click", function () {
        const input = document.getElementById("quantityInput");
        input.value = Math.max(1, parseInt(input.value || "1") - 1);
    });

    document.getElementById("increaseQty").addEventListener("click", function () {
        const input = document.getElementById("quantityInput");
        const nextValue = parseInt(input.value || "1") + 1;
        input.value = selectedStock ? Math.min(selectedStock, nextValue) : nextValue;
    });

    document.getElementById("cartForm").addEventListener("submit", function (e) {
        const variantId = document.getElementById("variantId").value;
        const quantity = parseInt(document.getElementById("quantityInput").value);

        if (!variantId) {
            e.preventDefault();
            showError();
            return;
        }

        if (quantity > selectedStock) {
            e.preventDefault();
            window.xbToast?.({
                title: "@T("Không đủ tồn kho", "Not enough stock")",
                message: text.outOfStock,
                icon: "bi-exclamation-circle"
            });
            return;
        }

        if (this.dataset.submitted !== "true") {
            e.preventDefault();
            this.dataset.submitted = "true";
            document.getElementById("addToCartBtn").classList.add("is-loading-submit");
            window.xbToast?.({
                title: "@T("Đang thêm vào giỏ", "Adding to cart")",
                message: "@T("Sản phẩm đang được chuyển vào giỏ hàng.", "The item is moving into your cart.")",
                icon: "bi-bag-plus"
            });

            const productImage = document.getElementById("mainImage");
            const animation = window.xbAnimateToCart ? window.xbAnimateToCart(productImage) : Promise.resolve();
            animation.finally(() => {
                this.submit();
            });
        }
    });

    function buyNow() {
        const variantId = document.getElementById("variantId").value;
        const quantity = parseInt(document.getElementById("quantityInput").value);

        if (!variantId) {
            showError();
            return;
        }

        if (quantity > selectedStock) {
            window.xbToast?.({
                title: "@T("Không đủ tồn kho", "Not enough stock")",
                message: text.outOfStock,
                icon: "bi-exclamation-circle"
            });
            return;
        }

        const form = document.createElement("form");
        form.method = "post";
        form.action = "/Order/BuyNow";

        const token = document.querySelector('#cartForm input[name="__RequestVerificationToken"]');
        if (token) {
            const hiddenToken = document.createElement("input");
            hiddenToken.type = "hidden";
            hiddenToken.name = "__RequestVerificationToken";
            hiddenToken.value = token.value;
            form.appendChild(hiddenToken);
        }

        const inputVariant = document.createElement("input");
        inputVariant.type = "hidden";
        inputVariant.name = "variantId";
        inputVariant.value = variantId;
        form.appendChild(inputVariant);

        const inputQuantity = document.createElement("input");
        inputQuantity.type = "hidden";
        inputQuantity.name = "quantity";
        inputQuantity.value = quantity;
        form.appendChild(inputQuantity);

        document.body.appendChild(form);
        form.submit();
    }

    document.getElementById("stickyBuyNow")?.addEventListener("click", buyNow);

    document.getElementById("stockNotifyBtn")?.addEventListener("click", function () {
        const input = document.getElementById("stockNotifyEmail");
        const email = input?.value?.trim() || "";
        const isValid = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email);
        window.xbToast?.({
            title: isValid ? "@T("Đã lưu yêu cầu", "Request saved")" : "@T("Email chưa hợp lệ", "Invalid email")",
            message: isValid ? text.notifySuccess : text.invalidEmail,
            icon: isValid ? "bi-envelope-check" : "bi-exclamation-circle"
        });
        if (isValid && input) input.value = "";
    });

    const mainImageFrame = document.querySelector(".detail-main-image");
    const mainImage = document.getElementById("mainImage");
    const zoomLens = document.getElementById("zoomLens");
    if (mainImageFrame && mainImage && zoomLens && window.matchMedia("(hover: hover)").matches) {
        mainImageFrame.addEventListener("mousemove", function (event) {
            const rect = mainImageFrame.getBoundingClientRect();
            const x = Math.max(0, Math.min(event.clientX - rect.left, rect.width));
            const y = Math.max(0, Math.min(event.clientY - rect.top, rect.height));
            const xPercent = (x / rect.width) * 100;
            const yPercent = (y / rect.height) * 100;

            zoomLens.style.left = `${x}px`;
            zoomLens.style.top = `${y}px`;
            zoomLens.style.backgroundImage = `url("${mainImage.src}")`;
            zoomLens.style.backgroundSize = `${rect.width * 2.2}px ${rect.height * 2.2}px`;
            zoomLens.style.backgroundPosition = `${xPercent}% ${yPercent}%`;
            zoomLens.classList.add("is-visible");
        });

        mainImageFrame.addEventListener("mouseleave", function () {
            zoomLens.classList.remove("is-visible");
        });
    }

    const lightbox = document.getElementById("detailLightbox");
    const lightboxImage = document.getElementById("lightboxImage");
    function openLightbox() {
        if (!lightbox || !lightboxImage) return;
        lightboxImage.src = galleryImages[currentGalleryIndex] || mainImage.src;
        lightbox.classList.add("is-open");
        lightbox.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
    }

    function closeLightbox() {
        if (!lightbox) return;
        lightbox.classList.remove("is-open");
        lightbox.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
    }

    function moveLightbox(step) {
        if (!galleryImages.length || !lightboxImage) return;
        currentGalleryIndex = (currentGalleryIndex + step + galleryImages.length) % galleryImages.length;
        lightboxImage.src = galleryImages[currentGalleryIndex];
        setMainImage(galleryImages[currentGalleryIndex]);
        document.querySelectorAll(".thumb-button").forEach((thumb, index) => {
            thumb.classList.toggle("active-thumb", index === currentGalleryIndex);
        });
    }

    document.getElementById("openLightbox")?.addEventListener("click", openLightbox);
    document.getElementById("closeLightbox")?.addEventListener("click", closeLightbox);
    document.getElementById("lightboxPrev")?.addEventListener("click", () => moveLightbox(-1));
    document.getElementById("lightboxNext")?.addEventListener("click", () => moveLightbox(1));
    lightbox?.addEventListener("click", event => {
        if (event.target === lightbox) closeLightbox();
    });
    document.addEventListener("keydown", event => {
        if (!lightbox?.classList.contains("is-open")) return;
        if (event.key === "Escape") closeLightbox();
        if (event.key === "ArrowLeft") moveLightbox(-1);
        if (event.key === "ArrowRight") moveLightbox(1);
    });

    const stickyBar = document.getElementById("stickyPdpBar");
    const actions = document.querySelector(".detail-actions");
    if (stickyBar && actions && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(entries => {
            const entry = entries[0];
            stickyBar.classList.toggle("is-visible", !entry.isIntersecting && window.scrollY > 360);
        }, { threshold: 0.2 });
        observer.observe(actions);
    }

    function showError() {
        const errorBox = document.getElementById("variantError");
        errorBox.style.display = "flex";
        window.xbToast?.({
            title: "@T("Chưa chọn phân loại", "Variant required")",
            message: "@T("Vui lòng chọn size và màu trước khi tiếp tục.", "Please choose size and color before continuing.")",
            icon: "bi-sliders"
        });
        errorBox.scrollIntoView({ behavior: "smooth", block: "center" });
        document.getElementById("addToCartBtn").classList.add("shake");
        document.getElementById("buyNowBtn").classList.add("shake");
        setTimeout(() => {
            document.getElementById("addToCartBtn").classList.remove("shake");
            document.getElementById("buyNowBtn").classList.remove("shake");
        }, 300);
    }

    const flashSaleEnd = "@(Model.FlashSaleEnd?.ToString("yyyy-MM-ddTHH:mm:ss") ?? "")";
    if (flashSaleEnd) {
        const countDownDate = new Date(flashSaleEnd).getTime();
        const timer = setInterval(function () {
            const now = new Date().getTime();
            const distance = countDownDate - now;
            const countdown = document.getElementById("countdown");

            if (distance <= 0) {
                countdown.innerHTML = text.ended;
                clearInterval(timer);
                return;
            }

            const h = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const m = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const s = Math.floor((distance % (1000 * 60)) / 1000);
            countdown.innerHTML = h + "h " + m + "m " + s + "s";
        }, 1000);
    }
</script>
}
