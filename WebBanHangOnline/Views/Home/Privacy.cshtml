@{
    ViewData["Title"] = "Chính sách";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/content.css" asp-append-version="true" />
}

<div class="content-page">
    <section class="content-hero compact">
        <span class="catalog-kicker">XuanBac care</span>
        <h1>Chính sách mua hàng</h1>
        <p>Thông tin giao hàng, thanh toán, đổi trả và bảo mật được trình bày rõ để bạn yên tâm trước khi đặt mua.</p>
    </section>

    <section class="policy-grid">
        <article class="policy-block">
            <i class="bi bi-truck"></i>
            <h2>Giao hàng</h2>
            <p>Shop giao hàng toàn quốc qua các đơn vị vận chuyển uy tín.</p>
            <ul>
                <li>Thời gian giao hàng dự kiến từ 2 - 5 ngày làm việc.</li>
                <li>Miễn phí vận chuyển cho đơn hàng trên 500.000 VND.</li>
                <li>Phí vận chuyển hiển thị rõ ở bước đặt hàng.</li>
            </ul>
        </article>

        <article class="policy-block">
            <i class="bi bi-credit-card"></i>
            <h2>Thanh toán</h2>
            <p>Bạn có thể chọn phương thức phù hợp khi hoàn tất đơn.</p>
            <ul>
                <li>Thanh toán khi nhận hàng.</li>
                <li>Chuyển khoản ngân hàng qua VietQR.</li>
                <li>Thanh toán qua VNPay hoặc MoMo khi được cấu hình.</li>
            </ul>
        </article>

        <article class="policy-block">
            <i class="bi bi-arrow-repeat"></i>
            <h2>Đổi trả</h2>
            <p>Hỗ trợ đổi trả trong 7 ngày kể từ ngày nhận hàng.</p>
            <ul>
                <li>Sản phẩm còn nguyên tem mác và chưa qua sử dụng.</li>
                <li>Áp dụng khi sản phẩm lỗi, sai mẫu hoặc sai size.</li>
                <li>Liên hệ hỗ trợ trước khi gửi hàng đổi trả.</li>
            </ul>
        </article>

        <article class="policy-block">
            <i class="bi bi-shield-check"></i>
            <h2>Bảo mật</h2>
            <p>Thông tin cá nhân chỉ dùng cho xử lý đơn hàng và chăm sóc khách hàng.</p>
            <ul>
                <li>Không chia sẻ thông tin khách hàng cho mục đích không liên quan.</li>
                <li>Dữ liệu đơn hàng được lưu để hỗ trợ tra cứu và bảo hành.</li>
                <li>Bạn có thể liên hệ shop khi cần cập nhật thông tin.</li>
            </ul>
        </article>
    </section>

    <section class="content-contact-band">
        <div>
            <h2>Cần hỗ trợ thêm?</h2>
            <p>Đội ngũ XuanBac sẵn sàng hỗ trợ về size, đơn hàng, thanh toán và đổi trả.</p>
        </div>
        <a asp-controller="Support" asp-action="Create">
            <i class="bi bi-headset"></i>
            Liên hệ hỗ trợ
        </a>
    </section>
</div>
