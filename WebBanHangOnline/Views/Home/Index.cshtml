@model List<WebBanHangOnline.Models.Product>
@{
    ViewData["Title"] = WebBanHangOnline.Helpers.CatalogTextHelper.T("Trang chủ", "Home");
    string T(string vi, string en) => WebBanHangOnline.Helpers.CatalogTextHelper.T(vi, en);
    string D(string? value) => WebBanHangOnline.Helpers.CatalogTextHelper.Display(value);
    var trendProducts = Model
        .Where(product => product.IsActive && !string.IsNullOrWhiteSpace(product.Thumbnail))
        .OrderBy(_ => Guid.NewGuid())
        .Take(3)
        .ToList();
    var heroProducts = Model
        .Where(product => product.IsActive && !string.IsNullOrWhiteSpace(product.Thumbnail))
        .OrderBy(product => product.ProductId)
        .Take(5)
        .ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/home.css" asp-append-version="true" />
}

<div class="home-page">

<!-- ================= HERO ================= -->
<section class="hero hero-3d container" data-hero-3d>
    <div class="hero-content">
        <small class="hero-kicker">XUANBAC FASHION</small>
        <h1>@T("Thời trang tinh tế cho phong cách mỗi ngày", "Refined fashion for everyday style")</h1>
        <p class="hero-copy">
            @T("Khám phá sản phẩm theo cách sống động, nhanh và dễ chọn hơn.",
                "Explore products in a vivid, faster and easier way.")
        </p>
        <div class="hero-proof">
            <span><i class="bi bi-lightning-charge-fill"></i> Flash sale</span>
            <span><i class="bi bi-box-seam"></i> @T("Có sẵn tồn kho", "In stock")</span>
            <span><i class="bi bi-credit-card"></i> @T("Nhiều thanh toán", "Multiple payments")</span>
        </div>

        <div class="hero-actions">
            <a asp-controller="Product"
               asp-action="Index"
               class="btn btn-primary rounded-pill hero-btn">
                @T("Mua sắm ngay", "Shop now")
            </a>
            <a href="#women"
               class="btn btn-outline-danger rounded-pill hero-btn">
                @T("Khám phá thời trang nữ", "Explore women's fashion")
            </a>
        </div>
    </div>
    <div class="hero-stage" aria-label="@T("Trình diễn sản phẩm 3D", "3D product showcase")">
        <div class="hero-orbit">
            <div class="hero-product hero-product-main">
                <img src="@(heroProducts.ElementAtOrDefault(0)?.Thumbnail ?? "/images/products/3e322809-1097-468a-8d36-c1c118ca9952.webp")"
                     alt="@T("Sản phẩm nổi bật XuanBac", "Featured XuanBac product")">
            </div>
            <div class="hero-product hero-product-back">
                <img src="@(heroProducts.ElementAtOrDefault(1)?.Thumbnail ?? "/images/products/c585b184-79a3-40f5-9d35-8e5bdd9db19e.webp")"
                     alt="@T("Sản phẩm thời trang", "Fashion product")">
            </div>
            <div class="hero-product hero-product-left">
                <img src="@(heroProducts.ElementAtOrDefault(2)?.Thumbnail ?? "/images/products/c3bc6230-25f9-4637-8659-7d824922f2ef.webp")"
                     alt="@T("Sản phẩm thời trang", "Fashion product")">
            </div>
            <div class="hero-product hero-product-right">
                <img src="@(heroProducts.ElementAtOrDefault(3)?.Thumbnail ?? "/images/products/c40ccd42-a351-4eb2-9a7a-2204c7fd7ee5.webp")"
                     alt="@T("Sản phẩm thời trang", "Fashion product")">
            </div>
            <div class="hero-product hero-product-mini">
                <img src="@(heroProducts.ElementAtOrDefault(4)?.Thumbnail ?? "/images/products/ebfc157b-4fa8-47c1-8437-32849bdc462a.webp")"
                     alt="@T("Sản phẩm thời trang", "Fashion product")">
            </div>
        </div>
    </div>
</section>

<!-- ================= WOMEN ================= -->
<section id="women" class="section container">
    <div class="row align-items-center">
        <div class="col-lg-5">
            <img src="/images/women-banner.jpg" class="img-fluid category-banner" alt="Thời trang nữ" loading="lazy">
        </div>
        <div class="col-lg-7">
            <p class="section-eyebrow">For women</p>
            <h4 class="section-title">@T("Thời trang nữ", "Women's fashion")</h4>
            <div class="row g-4">
                @foreach (var p in Model
                              .Where(x => x.Category != null 
                                          && x.Category.Name == "Đồ Nữ"
                                          && x.IsActive)
                              .Take(6))
                {
                    <div class="col-6 col-md-4">
                        <div class="product-card">
                            <span class="badge hot">HOT</span>
                            <a asp-controller="Product"
                               asp-action="Details"
                               asp-route-id="@p.ProductId"
                               asp-route-slug="@p.Slug">
                                <img src="@p.Thumbnail" />
                            </a>
                            <h6>@D(p.Name)</h6>
                            <div class="price">@p.Price.ToString("N0") VND</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>


<!-- ================= SALE ================= -->
<section class="sale-box">
    <div class="sale-left">
        <img src="/images/d.jpg">
        <p>@T("", "Mini backpack")</p>
    </div>
    <div class="sale-center">
        <h3>@T("Khuyến mãi giới hạn", "Limited promotion")</h3>
        <h2>50% OFF</h2>
    </div>
    <div class="sale-right">
        <img src="/images/c.jpg">
    </div>
</section>

<!-- ================= MEN ================= -->
<section class="section container">
    <div class="row align-items-center">
        <div class="col-lg-7">
            <p class="section-eyebrow">For men</p>
            <h4 class="section-title">@T("Thời trang nam", "Men's fashion")</h4>
            <div class="row g-4">
                @foreach (var p in Model
                              .Where(x => x.Category != null 
                                          && x.Category.Name == "Đồ Nam"
                                          && x.IsActive)
                              .Take(6))
                {
                    <div class="col-6 col-md-4">
                        <div class="product-card">
                            <span class="badge sale">SALE</span>
                            <a asp-controller="Product"
                               asp-action="Details"
                               asp-route-id="@p.ProductId"
                               asp-route-slug="@p.Slug">
                                <img src="@p.Thumbnail" />
                            </a>
                            <h6>@D(p.Name)</h6>
                            <div class="price">@p.Price.ToString("N0") VND</div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="col-lg-5">
            <img src="/images/men-banner.jpg" class="img-fluid category-banner" alt="Thời trang nam" loading="lazy">
        </div>
    </div>
</section>

<!-- ================= BOYS ================= -->
<section class="section container">
    <div class="row align-items-center">
        <div class="col-lg-5">
            <img src="/images/boys-banner.jpg" class="img-fluid category-banner" alt="Thời trang bé trai" loading="lazy">
        </div>
        <div class="col-lg-7">
            <p class="section-eyebrow">For boys</p>
            <h4 class="section-title">@T("Thời trang bé trai", "Boys' fashion")</h4>
            <div class="row g-4">
                @foreach (var p in Model
                              .Where(x => x.Category != null 
                                          && x.Category.Name == "Bé Trai"
                                          && x.IsActive)
                              .Take(6))
                {
                    <div class="col-6 col-md-4">
                        <div class="product-card">
                            <span class="badge hot">HOT</span>
                            <a asp-controller="Product"
                               asp-action="Details"
                               asp-route-id="@p.ProductId"
                               asp-route-slug="@p.Slug">
                                <img src="@p.Thumbnail" />
                            </a>
                            <h6>@D(p.Name)</h6>
                            <div class="price">@p.Price.ToString("N0") VND</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- ================= GIRLS ================= -->
<section class="section container">
    <div class="row align-items-center">
        <div class="col-lg-7">
            <p class="section-eyebrow">For girls</p>
            <h4 class="section-title">@T("Thời trang bé gái", "Girls' fashion")</h4>
            <div class="row g-4">
                @foreach (var p in Model
                              .Where(x => x.Category != null 
                                          && x.Category.Name == "Bé Gái"
                                          && x.IsActive)
                              .Take(6))
                {
                    <div class="col-6 col-md-4">
                        <div class="product-card">
                            <span class="badge sale">SALE</span>
                            <a asp-controller="Product"
                               asp-action="Details"
                               asp-route-id="@p.ProductId"
                               asp-route-slug="@p.Slug">
                                <img src="@p.Thumbnail" />
                            </a>
                            <h6>@D(p.Name)</h6>
                            <div class="price">@p.Price.ToString("N0") VND</div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="col-lg-5">
            <img src="/images/girls-banner.jpg" class="img-fluid category-banner" alt="Thời trang bé gái" loading="lazy">
        </div>
    </div>
</section>

<!-- ================= TABS ================= -->
<section class="tabs container">
    <div class="tab-head">
        <button class="tab-btn active" data-tab="popular">@T("Phổ biến", "Popular")</button>
        <button class="tab-btn" data-tab="hot">@T("Bán chạy", "Best sellers")</button>
        <button class="tab-btn" data-tab="sale">@T("Khuyến mãi", "On sale")</button>
    </div>

    <!-- ===== PHỔ BIẾN ===== -->
    <div class="tab-body active" id="popular">
        <div class="row g-4">
            @foreach (var p in Model.Take(8))
            {
                <div class="col-6 col-md-3">
                    <div class="product-card">
                        <a asp-controller="Product"
                           asp-action="Details"
                           asp-route-id="@p.ProductId"
                           asp-route-slug="@p.Slug"
                           class="product-link">

                            <img src="@p.Thumbnail" />
                            <h6>@D(p.Name)</h6>
                            <div class="price">@p.Price.ToString("N0") VND</div>

                        </a>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ===== BÁN CHẠY ===== -->
    <div class="tab-body" id="hot">
        <div class="row g-4">
            @foreach (var p in Model.Skip(4).Take(8))
            {
                <div class="col-6 col-md-3">
                    <div class="product-card">
                        <a asp-controller="Product"
                           asp-action="Details"
                           asp-route-id="@p.ProductId"
                           asp-route-slug="@p.Slug"
                           class="product-link">

                            <img src="@p.Thumbnail" />
                            <h6>@D(p.Name)</h6>
                            <div class="price">@p.Price.ToString("N0") VND</div>

                        </a>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ===== KHUYẾN MÃI ===== -->
    <div class="tab-body" id="sale">
        <div class="row g-4">
            @foreach (var p in Model.Skip(8).Take(8))
            {
                <div class="col-6 col-md-3">
                    <div class="product-card">
                        <a asp-controller="Product"
                           asp-action="Details"
                           asp-route-id="@p.ProductId"
                           asp-route-slug="@p.Slug"
                           class="product-link">

                            <img src="@p.Thumbnail" />
                            <h6>@D(p.Name)</h6>
                            <div class="price">@p.Price.ToString("N0") VND</div>

                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- ================= BLOG ================= -->
<section class="blog container">
    <h4 class="text-center mb-4">@T("Xu hướng thời trang", "Fashion trends")</h4>
    <div class="row g-4">
        @foreach (var trend in trendProducts)
        {
            <div class="col-md-4">
                <a asp-controller="Product"
                   asp-action="Details"
                   asp-route-id="@trend.ProductId"
                   asp-route-slug="@trend.Slug"
                   class="blog-card trend-card">
                    <img src="@trend.Thumbnail" class="img-fluid blog-img" alt="@D(trend.Name)" loading="lazy">
                    <div class="blog-body">
                        <span>@D(trend.Category?.Name)</span>
                        <h6>@D(trend.Name)</h6>
                    </div>
                </a>
            </div>
        }

        @if (!trendProducts.Any())
        {
            <div class="col-md-4">
                <div class="blog-card">
                    <img src="/images/blog1.jpg" class="img-fluid blog-img" alt="Blog 1" loading="lazy">
                    <div class="blog-body">
                        <h6>Beauty life style classic</h6>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="blog-card">
                    <img src="/images/blog2.jpg" class="img-fluid blog-img" alt="Blog 2" loading="lazy">
                    <div class="blog-body">
                        <h6>The need of life with vip style</h6>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="blog-card">
                    <img src="/images/blog3.jpg" class="img-fluid blog-img" alt="Blog 3" loading="lazy">
                    <div class="blog-body">
                        <h6>There is someone standing behind you</h6>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

</div>

@section Scripts {
<script>
document.querySelectorAll(".tab-btn").forEach(btn => {
    btn.addEventListener("click", () => {
        document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
        document.querySelectorAll(".tab-body").forEach(b => b.classList.remove("active"));

        btn.classList.add("active");
        document.getElementById(btn.dataset.tab).classList.add("active");
    });
});

const hero3d = document.querySelector("[data-hero-3d]");
const heroOrbit = hero3d?.querySelector(".hero-orbit");

if (hero3d && heroOrbit && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    hero3d.addEventListener("pointermove", event => {
        const rect = hero3d.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        heroOrbit.style.setProperty("--tilt-x", `${(-y * 8).toFixed(2)}deg`);
        heroOrbit.style.setProperty("--tilt-y", `${(x * 10).toFixed(2)}deg`);
    });

    hero3d.addEventListener("pointerleave", () => {
        heroOrbit.style.setProperty("--tilt-x", "0deg");
        heroOrbit.style.setProperty("--tilt-y", "0deg");
    });
}
</script>
}
