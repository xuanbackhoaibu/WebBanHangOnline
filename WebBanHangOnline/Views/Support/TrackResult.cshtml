@model List<WebBanHangOnline.Models.SupportRequest>

@{
    ViewData["Title"] = "Kết quả hỗ trợ";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/content.css" asp-append-version="true" />
}

<div class="support-page">
    <div class="content-hero compact">
        <span class="catalog-kicker">Support</span>
        <h1>Kết quả yêu cầu hỗ trợ</h1>
        <p>Theo dõi phản hồi và trạng thái xử lý các yêu cầu đã gửi.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="content-alert warning">
            Không tìm thấy yêu cầu nào với email này.
        </div>
    }
    else
    {
        <div class="content-table-card">
        <table class="table support-table">
            <thead>
            <tr>
                <th>Ngày gửi</th>
                <th>Nội dung</th>
                <th>Trạng thái</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@s.Message</td>
                    <td>
                        <span class="support-status @(s.Status == "New" ? "new" : s.Status == "InProgress" ? "progressing" : "done")">
                            @s.Status
                        </span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    }

    <a asp-action="Track" class="content-secondary-btn mt-3">
        Tra cứu lại
    </a>
</div>
