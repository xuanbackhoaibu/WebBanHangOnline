@model WebBanHangOnline.Models.SupportRequest

@{
    ViewData["Title"] = "Gửi yêu cầu hỗ trợ";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/content.css" asp-append-version="true" />
}

<div class="support-page">
    <div class="content-hero compact">
        <span class="catalog-kicker">Support</span>
        <h1>Gửi yêu cầu hỗ trợ</h1>
        <p>Cho chúng tôi biết vấn đề bạn gặp phải, đội hỗ trợ sẽ phản hồi sớm nhất có thể.</p>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="content-alert success">
            @TempData["success"]
        </div>
    }

    <form asp-action="Create" method="post" class="content-form-card">

        <div class="mb-3">
            <label class="form-label">Họ tên</label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Nội dung</label>
            <textarea asp-for="Message" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Message" class="text-danger"></span>
        </div>

        <button type="submit" class="content-primary-btn">
            Gửi yêu cầu
        </button>

        <a asp-action="Index" class="content-secondary-btn">
            Quay lại
        </a>
    </form>
</div>
