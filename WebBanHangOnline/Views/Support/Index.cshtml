@model List<WebBanHangOnline.Models.SupportFaq>

@{
    ViewData["Title"] = "Trung tâm hỗ trợ";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/content.css" asp-append-version="true" />
}

<div class="support-page">
    <div class="content-hero">
        <span class="catalog-kicker">Support</span>
        <h1>Trung tâm hỗ trợ</h1>
        <p>Tìm câu trả lời nhanh, gửi yêu cầu hỗ trợ hoặc theo dõi phản hồi từ XuanBac.</p>
    </div>

    <div class="support-action-grid">
        <div class="support-action-card">
                <i class="bi bi-question-circle"></i>
                <h6 class="mt-2">Câu hỏi thường gặp</h6>
                <p>Giải đáp nhanh các vấn đề phổ biến</p>
        </div>

        <a asp-action="Create" class="support-action-card">
                    <i class="bi bi-chat-dots"></i>
                    <h6 class="mt-2">Gửi yêu cầu</h6>
                    <p>Liên hệ với bộ phận hỗ trợ</p>
        </a>

        <a asp-action="Track" class="support-action-card">
                    <i class="bi bi-search"></i>
                    <h6 class="mt-2">Theo dõi yêu cầu</h6>
                    <p>Kiểm tra trạng thái hỗ trợ</p>
        </a>
    </div>

    <h2 class="content-section-title">Câu hỏi thường gặp</h2>

    <div class="accordion mt-3" id="faqAccordion">
        @foreach (var f in Model)
        {
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#faq_@f.SupportFaqId">
                        @f.Question
                    </button>
                </h2>
                <div id="faq_@f.SupportFaqId"
                     class="accordion-collapse collapse"
                     data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        @f.Answer
                    </div>
                </div>
            </div>
        }
    </div>
</div>
