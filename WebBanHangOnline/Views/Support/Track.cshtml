@{
    ViewData["Title"] = "Theo dõi hỗ trợ";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/content.css" asp-append-version="true" />
}

<div class="support-page">
    <div class="content-hero compact">
        <span class="catalog-kicker">Support</span>
        <h1>Theo dõi yêu cầu hỗ trợ</h1>
        <p>Nhập email đã dùng khi gửi yêu cầu để kiểm tra trạng thái xử lý.</p>
    </div>

    <form asp-action="Track" method="post" class="content-form-card">

        <div class="mb-3">
            <label class="form-label">Nhập email của bạn</label>
            <input name="email" class="form-control" required />
        </div>

        <button type="submit" class="content-primary-btn">
            Tra cứu
        </button>

        <a asp-action="Index" class="content-secondary-btn">
            Quay lại
        </a>
    </form>
</div>
