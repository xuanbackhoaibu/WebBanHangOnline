@{
    ViewData["Title"] = "Thanh toán VietQR";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/vietqr.css" asp-append-version="true" />
}

<div class="vietqr-page">
    <h1>Quét mã để thanh toán</h1>

    <img src="@ViewBag.QrUrl"
         class="vietqr-image"
         alt="Mã QR thanh toán VietQR" />

    <p><b>Số tiền:</b> @ViewBag.Amount VND</p>
    <p><b>Nội dung:</b> Chuyển tiền</p>

    <p class="vietqr-warning">
        Vui lòng chuyển đúng nội dung để xác nhận.
    </p>

    <form method="post" asp-area="" asp-controller="Payment" asp-action="ConfirmPaid">
        @Html.AntiForgeryToken()
        <input type="hidden" name="orderId" value="@ViewBag.OrderId" />
        <button type="submit" class="btn btn-success">
            Tôi đã thanh toán
        </button>
    </form>
</div>
