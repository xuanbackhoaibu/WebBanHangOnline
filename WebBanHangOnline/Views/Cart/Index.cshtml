@model List<CartItem>
@{
    var cartItemCount = Model.Sum(item => item.Quantity);
    var cartTotal = Model.Sum(item => item.ProductVariant.Product.Price * item.Quantity);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/cart.css" asp-append-version="true" />
}

<div class="cart-page">
    <div class="cart-heading">
        <div>
            <span class="catalog-kicker">Shopping cart</span>
            <h1>Giỏ hàng của bạn</h1>
            <p>Chọn sản phẩm muốn thanh toán, kiểm tra số lượng và tiến hành đặt hàng.</p>
        </div>
        <a asp-area="" asp-controller="Product" asp-action="Index" class="catalog-cart-link">
            <i class="bi bi-arrow-left"></i>
            Tiếp tục mua sắm
        </a>
    </div>

    @if (!Model.Any())
    {
    <div class="empty-state">
        <i class="bi bi-bag"></i>
        <h3>Giỏ hàng đang trống</h3>
        <p>Khám phá bộ sưu tập mới và thêm sản phẩm bạn thích vào giỏ.</p>
        <a asp-area="" asp-controller="Product" asp-action="Index" class="btn btn-filter">Mua sắm ngay</a>
    </div>
    }
    else
    {
    <div class="cart-layout">
        <section class="cart-items-panel">
            <div class="cart-panel-head">
                <label class="cart-select-all">
                    <input type="checkbox" id="selectAll" />
                    <span>Chọn tất cả</span>
                </label>
                <span>@Model.Count sản phẩm, @cartItemCount món</span>
            </div>

            <div class="cart-items-list">
                @foreach (var item in Model)
                {
                    var product = item.ProductVariant.Product;
                    var price = product.Price;
                    var sub = price * item.Quantity;

                    <article class="cart-item-card">
                        <div class="cart-check">
                            <input type="checkbox"
                                   class="item-checkbox"
                                   value="@item.Id"
                                   data-sub="@sub" />
                        </div>

                        <a asp-area=""
                           asp-controller="Product"
                           asp-action="Details"
                           asp-route-id="@product.ProductId"
                           asp-route-slug="@product.Slug"
                           class="cart-item-image">
                            <img src="@product.Thumbnail" alt="@product.Name" loading="lazy" />
                        </a>

                        <div class="cart-item-info">
                            <div class="cart-item-main">
                                <div>
                                    <a asp-area=""
                                       asp-controller="Product"
                                       asp-action="Details"
                                       asp-route-id="@product.ProductId"
                                       asp-route-slug="@product.Slug"
                                       class="cart-item-name">
                                        @product.Name
                                    </a>
                                    <div class="cart-variant">
                                        <span>Size @item.ProductVariant.Size</span>
                                        <span>@item.ProductVariant.Color</span>
                                    </div>
                                </div>

                                <form asp-area=""
                                      asp-action="Remove"
                                      asp-route-id="@item.Id"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="cart-remove-btn"
                                            onclick="return confirm('Xóa sản phẩm này?')">
                                        <i class="bi bi-trash"></i>
                                        Xóa
                                    </button>
                                </form>
                            </div>

                            <div class="cart-item-meta">
                                <div>
                                    <span class="cart-meta-label">Đơn giá</span>
                                    <strong>@price.ToString("N0") VND</strong>
                                </div>

                                <form asp-area=""
                                      asp-action="Update"
                                      method="post"
                                      class="cart-qty-control">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />

                                    <button type="submit"
                                            name="quantity"
                                            value="@(item.Quantity - 1)"
                                            @(item.Quantity <= 1 ? "disabled" : "")>
                                        −
                                    </button>

                                    <input type="text"
                                           class="cart-quantity-input"
                                           value="@item.Quantity"
                                           readonly />

                                    <button type="submit"
                                            name="quantity"
                                            value="@(item.Quantity + 1)">
                                        +
                                    </button>
                                </form>

                                <div class="cart-line-total">
                                    <span class="cart-meta-label">Tạm tính</span>
                                    <strong>@sub.ToString("N0") VND</strong>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>

        <aside class="cart-summary-panel">
            <div class="cart-summary">
                <span class="catalog-kicker">Checkout</span>
                <h4>Tóm tắt giỏ hàng</h4>

                <div class="summary-row">
                    <span>Tổng trong giỏ</span>
                    <strong>@cartTotal.ToString("N0") VND</strong>
                </div>
                <div class="summary-row">
                    <span>Đã chọn</span>
                    <strong><span id="selectedCount">0</span> sản phẩm</strong>
                </div>
                <div class="summary-total">
                    <span>Tổng tiền đã chọn</span>
                    <strong id="selectedTotal">0 VND</strong>
                </div>

                <button class="cart-checkout-btn"
                        id="checkoutBtn"
                        disabled>
                    Tiến hành đặt hàng
                    <i class="bi bi-arrow-right"></i>
                </button>
            </div>
        </aside>
    </div>
    }
</div>

@section Scripts{
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const checkboxes = document.querySelectorAll(".item-checkbox");
        const selectAll = document.getElementById("selectAll");
        const totalDisplay = document.getElementById("selectedTotal");
        const selectedCountDisplay = document.getElementById("selectedCount");
        const checkoutBtn = document.getElementById("checkoutBtn");

        if (!totalDisplay || !selectedCountDisplay || !checkoutBtn) return;

        const STORAGE_KEY = "selectedCartItems";

        function formatMoney(number) {
            return number.toLocaleString('vi-VN') + " VND";
        }

        function updateTotal() {
            let total = 0;
            let selectedIds = [];

            checkboxes.forEach(cb => {
                if (cb.checked) {
                    total += parseFloat(cb.dataset.sub);
                    selectedIds.push(cb.value);
                }
            });

            totalDisplay.innerText = formatMoney(total);
            selectedCountDisplay.innerText = selectedIds.length.toString();
            checkoutBtn.disabled = selectedIds.length === 0;

            // Lưu trạng thái để reload không mất
            localStorage.setItem(STORAGE_KEY, JSON.stringify(selectedIds));
        }

        function restoreSelection() {
            let saved = localStorage.getItem(STORAGE_KEY);
            if (!saved) return;

            let selectedIds = JSON.parse(saved);

            checkboxes.forEach(cb => {
                if (selectedIds.includes(cb.value)) {
                    cb.checked = true;
                }
            });

            updateTotal();
        }

        selectAll?.addEventListener("change", function () {
            checkboxes.forEach(cb => cb.checked = this.checked);
            updateTotal();
        });

        checkboxes.forEach(cb => {
            cb.addEventListener("change", updateTotal);
        });

        // Lấy trực tiếp checkbox đang chọn khi submit.
        checkoutBtn?.addEventListener("click", function () {

            let selected = [];

            document.querySelectorAll(".item-checkbox:checked")
                .forEach(cb => selected.push(cb.value));

            if (selected.length === 0) {
                window.xbToast?.({
                    title: "Chưa chọn sản phẩm",
                    message: "Vui lòng chọn ít nhất một sản phẩm để đặt hàng.",
                    icon: "bi-bag-check"
                });
                return;
            }

            let form = document.createElement("form");
            form.method = "post";
            form.action = '@Url.Action("CheckoutSelected","Order")';

            let token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                let hiddenToken = document.createElement("input");
                hiddenToken.type = "hidden";
                hiddenToken.name = "__RequestVerificationToken";
                hiddenToken.value = token.value;
                form.appendChild(hiddenToken);
            }

            selected.forEach(id => {
                let input = document.createElement("input");
                input.type = "hidden";
                input.name = "selectedItems";
                input.value = id;
                form.appendChild(input);
            });

            document.body.appendChild(form);
            form.submit();
        });

        restoreSelection();
    });
</script>
}
