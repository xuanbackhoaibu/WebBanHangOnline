@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    string T(string vi, string en) => WebBanHangOnline.Helpers.CatalogTextHelper.T(vi, en);
}

@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle text-decoration-none"
           href="javascript:void(0)"
           role="button"
           data-bs-toggle="dropdown"
           aria-expanded="false">
            <i class="bi bi-person-circle"></i>
            @User.Identity?.Name
        </a>

        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <a class="dropdown-item"
                   asp-area="Identity"
                   asp-page="/Account/Manage/Index">
                    @T("Tài khoản của tôi", "My account")
                </a>
            </li>

            <li>
                <a class="dropdown-item"
                   asp-area=""
                   asp-controller="Order"
                   asp-action="MyOrders">
                    @T("Đơn mua", "My orders")
                </a>
            </li>

            <li><hr class="dropdown-divider" /></li>

            <li>
                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action("Index","Home", new { area = "" })"
                      method="post">
                    <button type="submit"
                            class="dropdown-item text-danger">
                        @T("Đăng xuất", "Sign out")
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="topbar-auth-link topbar-auth-login"
           asp-area="Identity"
           asp-page="/Account/Login">
            <i class="bi bi-box-arrow-in-right me-1"></i>
            @T("Đăng nhập", "Sign in")
        </a>
    </li>

    <li class="nav-item ms-2">
        <a class="topbar-auth-link topbar-auth-register"
           asp-area="Identity"
           asp-page="/Account/Register">
            <i class="bi bi-person-plus me-1"></i>
            @T("Đăng ký", "Register")
        </a>
    </li>
}
