@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using WebBanHangOnline.Data
@using WebBanHangOnline.Models
@inject ApplicationDbContext LayoutDbContext
@inject UserManager<ApplicationUser> LayoutUserManager
@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isEnglish = currentCulture == "en";
    var returnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isIntroPage = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "About", StringComparison.OrdinalIgnoreCase);
    var cartCount = 0;
    var wishlistCount = 0;
    var cartPreviewItems = new List<CartItem>();

    if (User.Identity?.IsAuthenticated == true)
    {
        var layoutUserId = LayoutUserManager.GetUserId(User);
        cartCount = await LayoutDbContext.CartItems
            .Where(item => item.UserId == layoutUserId)
            .SumAsync(item => (int?)item.Quantity) ?? 0;
        wishlistCount = await LayoutDbContext.WishlistItems
            .Where(item => item.UserId == layoutUserId)
            .CountAsync();
        cartPreviewItems = await LayoutDbContext.CartItems
            .Where(item => item.UserId == layoutUserId)
            .Include(item => item.ProductVariant)
                .ThenInclude(variant => variant.Product)
            .OrderByDescending(item => item.Id)
            .Take(3)
            .ToListAsync();
    }

    string T(string vi, string en) => isEnglish ? en : vi;
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#d94f3d" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="ShopOnline" />
    <title>@ViewData["Title"] - WebBanHangOnline</title>
    <link rel="manifest" href="~/manifest.json" />
    <script>
        (function () {
            const savedTheme = localStorage.getItem("xb-theme");
            const prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
            document.documentElement.dataset.theme = savedTheme || (prefersDark ? "dark" : "light");
        })();
    </script>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/fonts/be-vietnam-pro@latest/vietnamese-400-normal.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/fonts/be-vietnam-pro@latest/vietnamese-500-normal.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/fonts/be-vietnam-pro@latest/vietnamese-600-normal.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/fonts/be-vietnam-pro@latest/vietnamese-700-normal.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/fonts/playfair-display@latest/vietnamese-600-normal.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/fonts/playfair-display@latest/vietnamese-600-italic.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/fonts/ibm-plex-mono@latest/vietnamese-400-normal.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/fonts/ibm-plex-mono@latest/vietnamese-500-normal.min.css">

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebBanHangOnline.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chatbot.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="~/css/muva.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/muva-sync.css" asp-append-version="true" />
</head>
<body class="coutura-body">

    <!-- ================= TOP BAR ================= -->
    <div class="coutura-topbar">
        <div class="container d-flex justify-content-between align-items-center small">

            <div class="d-flex gap-3 align-items-center">
                <span><i class="bi bi-truck"></i> @T("Giao hàng toàn quốc", "Nationwide delivery")</span>
                <span class="d-none d-md-inline"><i class="bi bi-shield-check"></i> @T("Đổi trả trong 7 ngày", "7-day returns")</span>
            </div>

            <div class="d-flex align-items-center gap-4">

                <a asp-area=""
                   asp-controller="Notification"
                   asp-action="Index"
                   class="text-decoration-none">
                    <i class="bi bi-bell"></i> @T("Thông báo", "Notifications")
                </a>

                <a asp-area=""
                   asp-controller="Support"
                   asp-action="Index"
                   class="text-decoration-none">
                    <i class="bi bi-question-circle"></i> @T("Hỗ trợ", "Support")
                </a>
                <!-- Ngôn ngữ -->
                <div class="dropdown">
                    <a class="dropdown-toggle text-decoration-none"
                       href="javascript:void(0)"
                       data-bs-toggle="dropdown">
                        <span class="language-flag" aria-hidden="true">@(isEnglish ? "🇬🇧" : "🇻🇳")</span>
                        @(isEnglish ? "English" : "Tiếng Việt")
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item"
                               asp-area=""
                               asp-controller="Language"
                               asp-action="SetLanguage"
                               asp-route-culture="vi"
                               asp-route-returnUrl="@returnUrl">
                                <span class="language-flag" aria-hidden="true">🇻🇳</span>
                                Tiếng Việt
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item"
                               asp-area=""
                               asp-controller="Language"
                               asp-action="SetLanguage"
                               asp-route-culture="en"
                               asp-route-returnUrl="@returnUrl">
                                <span class="language-flag" aria-hidden="true">🇬🇧</span>
                                English
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- LOGIN / USER -->
                <ul class="nav align-items-center mb-0">
                    <partial name="_LoginPartial" />
                </ul>

            </div>

        </div>
    </div>

    <!-- ================= HEADER ================= -->
    <header class="coutura-header">
        <div class="container d-flex align-items-center justify-content-between gap-4">

            <!-- LOGO -->
            <a asp-area=""
               asp-controller="Home"
               asp-action="Index"
               class="coutura-logo">
                XuanBac<span>.</span>
            </a>

            <!-- SEARCH -->
            <form asp-area=""
                  asp-controller="Product"
                  asp-action="Index"
                  method="get"
                  class="coutura-search flex-grow-1">

                <input type="text"
                       name="keyword"
                       class="form-control"
                       placeholder="@T("Tìm sản phẩm...", "Search products...")" />

                <button type="submit" class="btn btn-search">
                    <i class="bi bi-search"></i>
                </button>
            </form>

            <!-- ICONS -->
            <div class="header-icons d-flex align-items-center gap-3">

                <a asp-area="" asp-controller="Product" asp-action="Index" class="icon-btn" title="@T("Tìm kiếm", "Search")">
                    <i class="bi bi-search"></i>
                </a>

                <button type="button"
                        id="themeToggle"
                        class="icon-btn theme-toggle"
                        title="@T("Chuyển giao diện sáng/tối", "Toggle light/dark theme")"
                        aria-label="@T("Chuyển giao diện sáng/tối", "Toggle light/dark theme")">
                    <i class="bi bi-moon-stars"></i>
                </button>

                <a asp-area=""
                   asp-controller="Wishlist"
                   asp-action="Index"
                   class="icon-btn position-relative"
                   title="@T($"Yêu thích: {wishlistCount} sản phẩm", $"Wishlist: {wishlistCount} items")">
                    <i class="bi bi-heart"></i>
                    @if (wishlistCount > 0)
                    {
                        <span class="cart-badge wishlist-badge">@wishlistCount</span>
                    }
                </a>

                <!-- CART -->
                <div class="cart-action-wrap">
                    <a asp-area=""
                       asp-controller="Cart"
                       asp-action="Index"
                       class="icon-btn position-relative xb-cart-target"
                       data-bs-toggle="offcanvas"
                       data-bs-target="#cartDrawer"
                       aria-controls="cartDrawer"
                       title="@T($"Giỏ hàng: {cartCount} sản phẩm", $"Cart: {cartCount} items")">
                        <i class="bi bi-bag"></i>
                        @if (cartCount > 0)
                        {
                            <span class="cart-badge">@cartCount</span>
                        }
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- ================= MENU ================= -->
    <nav class="coutura-menu">
        <div class="container">
            <ul class="nav py-2 align-items-center">

                <li class="nav-item">
                    <a class="nav-link"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index">
                        @T("Trang chủ", "Home")
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       asp-area=""
                       asp-controller="Product"
                       asp-action="Index">
                        @T("Sản phẩm", "Products")
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       asp-area=""
                       asp-controller="Product"
                       asp-action="Sale">
                        @T("Ưu đãi", "Sale")
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="About">
                        @T("Giới thiệu", "About")
                    </a>
                </li>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-area=""
                           asp-controller="Order"
                           asp-action="MyOrders">
                            @T("Đơn hàng của tôi", "My orders")
                        </a>
                    </li>
                }

                @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                {
                    <li class="nav-item dropdown ms-auto">
                        <a class="nav-link dropdown-toggle admin-link"
                           href="javascript:void(0)"
                           data-bs-toggle="dropdown">
                            Admin
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item"
                                   asp-area="Admin"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    Dashboard
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-area="Admin"
                                   asp-controller="Product"
                                   asp-action="Index">
                                    @T("Quản lý sản phẩm", "Products management")
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-area="Admin"
                                   asp-controller="Order"
                                   asp-action="Index">
                                    @T("Quản lý đơn hàng", "Orders management")
                                </a>
                            </li>
                        </ul>
                    </li>
                }

            </ul>
        </div>
    </nav>

    <!-- ================= MAIN ================= -->
    <div class="page-loader" aria-hidden="true">
        <div class="page-loader-card">
            <span class="skeleton-line wide"></span>
            <span class="skeleton-line"></span>
            <span class="skeleton-grid">
                <i></i>
                <i></i>
                <i></i>
            </span>
        </div>
    </div>
    <div id="toastRoot" class="toast-root" aria-live="polite" aria-atomic="true"></div>

    <div class="container site-shell">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- ================= FOOTER ================= -->
    <footer class="shop-footer">
        <div class="container footer-grid">

            <!-- LOGO + MÔ TẢ -->
            <div class="footer-col">
                <h4 class="logo">XUANBAC</h4>
                <p>@T("Shop thời trang hiện đại dành cho nam, nữ và trẻ em. Luôn cập nhật xu hướng mới nhất.",
                    "Modern fashion shop for men, women and kids. Always updated with the latest trends.")</p>

                <div class="social">
                    <a href="https://www.facebook.com/xuan.bac0706">Facebook</a>
                    <a href="https://www.instagram.com/bc_pupyw">Instagram</a>
                    <a href="https://www.tiktok.com/">TikTok</a>
                </div>
            </div>

            <!-- THÔNG TIN -->
            <div class="footer-col">
                <h6>@T("Thông tin", "Information")</h6>
                <ul>
                    <li><a asp-area="" asp-controller="Home" asp-action="Index">@T("Trang chủ", "Home")</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="About">@T("Giới thiệu", "About")</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Privacy">@T("Chính sách", "Policy")</a></li>
                    <li><a asp-area="" asp-controller="Support" asp-action="Create">@T("Liên hệ", "Contact")</a></li>
                </ul>
            </div>

            <!-- HỖ TRỢ -->
            <div class="footer-col">
                <h6>@T("Hỗ trợ", "Support")</h6>
                <ul>
                    <li><a asp-area="" asp-controller="Support" asp-action="Index">@T("Hỏi đáp", "FAQ")</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Privacy">@T("Giao hàng", "Delivery")</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Privacy">@T("Thanh toán", "Payment")</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Privacy">@T("Đổi trả", "Returns")</a></li>
                </ul>
            </div>

            <!-- FOOTER ACTION -->
            <div class="footer-col">
                @if (isIntroPage)
                {
                    <div class="footer-store-cta">
                        <h6>@T("Sẵn sàng chạm vào chất liệu thật?", "Ready to feel the real fabric?")</h6>
                        <p>@T("Toàn bộ bộ sưu tập mới đã lên kệ cửa hàng trực tuyến.", "The full new collection is now available in the online store.")</p>
                        <a asp-area="" asp-controller="Home" asp-action="Index" asp-route-enterShop="true">
                            @T("Vào cửa hàng", "Enter store")
                        </a>
                    </div>
                }
                else
                {
                    <h6>@T("Đăng ký nhận tin", "Newsletter")</h6>
                    <p>@T("Nhận thông tin khuyến mãi mới nhất.", "Get the latest promotions.")</p>

                    <div class="newsletter">
                        <input type="email" placeholder="@T("Nhập email của bạn", "Enter your email")">
                        <button>@T("Đăng ký", "Subscribe")</button>
                    </div>
                }

                <p class="contact">
                    Hotline: 0123 456 789<br>
                    Email: support@xuanbac.vn
                </p>
            </div>

        </div>

        <!-- COPYRIGHT -->
        <div class="footer-bottom">
            © 2026 XuanBac Fashion. All rights reserved.
        </div>
    </footer>

    <nav class="mobile-shop-nav" aria-label="@T("Điều hướng nhanh", "Quick navigation")">
        <a asp-area="" asp-controller="Home" asp-action="Index">
            <i class="bi bi-house"></i>
            <span>@T("Trang chủ", "Home")</span>
        </a>
        <a asp-area="" asp-controller="Product" asp-action="Index">
            <i class="bi bi-grid"></i>
            <span>@T("Sản phẩm", "Products")</span>
        </a>
        <a asp-area="" asp-controller="Wishlist" asp-action="Index" class="position-relative">
            <i class="bi bi-heart"></i>
            <span>@T("Yêu thích", "Wishlist")</span>
            @if (wishlistCount > 0)
            {
                <b>@wishlistCount</b>
            }
        </a>
        <a asp-area="" asp-controller="Cart" asp-action="Index" class="position-relative">
            <i class="bi bi-bag"></i>
            <span>@T("Giỏ hàng", "Cart")</span>
            @if (cartCount > 0)
            {
                <b>@cartCount</b>
            }
        </a>
    </nav>

    <aside class="offcanvas offcanvas-end cart-drawer" tabindex="-1" id="cartDrawer" aria-labelledby="cartDrawerLabel">
        <div class="cart-drawer-header">
            <div>
                <small>@T("Giỏ hàng của bạn", "Your cart")</small>
                <h5 id="cartDrawerLabel">@cartCount @T("sản phẩm", "items")</h5>
            </div>
            <button type="button" class="cart-drawer-close" data-bs-dismiss="offcanvas" aria-label="@T("Đóng", "Close")">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="cart-drawer-body">
            @if (cartPreviewItems.Any())
            {
                <div class="cart-drawer-list">
                    @foreach (var item in cartPreviewItems)
                    {
                        var product = item.ProductVariant?.Product;
                        var unitPrice = item.ProductVariant?.Price ?? product?.FinalPrice ?? 0;
                        <a asp-area=""
                           asp-controller="Product"
                           asp-action="Details"
                           asp-route-id="@product?.ProductId"
                           asp-route-slug="@product?.Slug"
                           class="cart-drawer-item">
                            <img src="@(product?.Thumbnail ?? "/images/no-image.png")" alt="@(product?.Name ?? "Product")" />
                            <span>
                                <strong>@(product?.Name ?? T("Sản phẩm", "Product"))</strong>
                                <small>@item.Quantity x @unitPrice.ToString("N0") VND</small>
                            </span>
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="cart-drawer-empty">
                    <i class="bi bi-bag"></i>
                    <strong>@T("Giỏ hàng đang trống", "Your cart is empty")</strong>
                    <span>@T("Chọn vài sản phẩm yêu thích để bắt đầu đơn hàng.", "Pick a few favorites to start your order.")</span>
                </div>
            }
        </div>

        <div class="cart-drawer-footer">
            <a asp-area="" asp-controller="Cart" asp-action="Index" class="cart-drawer-secondary">
                <i class="bi bi-basket2"></i>
                @T("Xem giỏ hàng", "View cart")
            </a>
            <a asp-area="" asp-controller="Order" asp-action="Checkout" class="cart-drawer-primary">
                <i class="bi bi-credit-card"></i>
                @T("Thanh toán", "Checkout")
            </a>
        </div>
    </aside>

    @RenderSection("Scripts", required: false)

    <!-- ===== CHATBOT WIDGET ===== -->
    <input type="hidden"
           id="xb-chat-welcome"
           value="@T("Xin chào", "Hello") @(User.Identity?.IsAuthenticated == true ? User.Identity?.Name : T("bạn", "there"))! @T("Bạn muốn mình tư vấn gì: size, phối đồ, hay gợi ý theo ngân sách?", "What would you like help with: sizing, outfit styling, or suggestions by budget?")" />

    <div id="xb-chat-btn" title="@T("Chat tư vấn", "Style chat")">
        <i class="bi bi-chat-dots-fill"></i>
    </div>

    <div id="xb-chat-box" aria-live="polite">
        <div id="xb-chat-header">
            <div class="xb-chat-title">
                <div class="xb-chat-avatar">XB</div>
                <div class="xb-chat-title-text">
                    <b>@T("Tư vấn nhanh", "Quick styling")</b>
                    <span id="xb-chat-status" class="xb-chat-status">@T("Đang kết nối...", "Connecting...")</span>
                </div>
            </div>
            <div class="xb-chat-actions">
                <button type="button" id="xb-chat-clear" class="xb-icon-btn" title="@T("Xoá lịch sử", "Clear history")">
                    <i class="bi bi-trash3"></i>
                </button>
                <button type="button" id="xb-chat-close" class="xb-icon-btn" title="@T("Đóng", "Close")">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        <div id="xb-chat-body"></div>

        <div id="xb-chat-input">
            <input id="xb-chat-msg" placeholder="@T("Nhập tin nhắn...", "Type a message...")" autocomplete="off" />
            <button id="xb-chat-send" type="button">@T("Gửi", "Send")</button>
        </div>
    </div>
    <!-- ===== END CHATBOT WIDGET ===== -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/chatbot.js" asp-append-version="true"></script>
</body>
</html>
